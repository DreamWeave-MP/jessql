--!strict
-- Build RSS and time, isolated from snapshot construction and query workloads.
-- Run prepare once, then alternate builder runs using distinct Jess processes.
local sql = require('@jessql')
local fs = require('@dream/fs')
local mode = arg[1] or 'build'
local count = tonumber(arg[2]) or 100000
local runRows = tonumber(arg[3]) or 4096
local fanIn = tonumber(arg[4]) or 8
local indexFormat = arg[5] or 'paged'
local base = fs.join(fs.cwd() :: string, '.jessql-secondary-build')
local cold, indexPath = base .. '.cold', base .. '.idx'
local function rss(): number
  -- /proc is Linux-specific; absence means RSS measurement is unavailable.
  local ok, content = pcall(fs.readFileString, '/proc/self/status')
  if not ok or type(content) ~= 'string' then return -1 end
  local raw = string.match(content, 'VmRSS:%s+(%d+)')
  return if raw then tonumber(raw) or -1 else -1
end

if mode == 'prepare' then
  fs.remove(cold)
  local cursor = 0
  sql.paged.create(cold, { 'id', 'room', 'stream', 'body' }, 'id', function()
    cursor += 1
    if cursor > count then return nil end

    return { id = cursor, room = 'room-' .. tostring(cursor % 48),
      stream = math.floor(cursor / 48), body = 'event-' .. tostring(cursor) }
  end)
  print('prepared', count)
  return
end

fs.remove(indexPath)
local started = os.clock()
local metrics = sql.secondary.create(indexPath, cold, 'room', 'stream',
  { runRows = runRows, mergeFanIn = fanIn, format = indexFormat })
print('build_seconds', os.clock() - started)
print('index_format', indexFormat)
local file = fs.open(indexPath)
if file then print('index_bytes', file:size()); file:close() end
print('rss_after_build_KiB', rss())
if metrics then
  print('spilled_runs', metrics.spilledRuns)
  print('merge_operations', metrics.mergeOperations)
  print('max_buffered_entries', metrics.maxBufferedEntries)
  print('max_open_readers', metrics.maxOpenReaders)
end
local source = sql.paged.open(cold)
local index = sql.secondary.open(indexPath, source, { cachePages = 2 })
local reader = index:iterate('room-7', false, 100, 1200, false, false)
local checksum = 0
while true do
  local row = reader()
  if not row then break end
  checksum += row.id :: number
end
print('lookup_checksum', checksum)
local queryStart = os.clock()
local queryChecksum = 0
for attempt = 1, 120 do
  local room = 'room-' .. tostring(attempt % 48)
  local nextEvent = index:iterate(room, false, 100, 140)
  while true do
    local event = nextEvent()
    if not event then break end
    queryChecksum += event.id :: number
  end
end
print('bounded_query_seconds', os.clock() - queryStart)
print('bounded_query_checksum', queryChecksum)
print('sidecar_page_reads', index:stats().pageReads)
index:close()
source:close()
