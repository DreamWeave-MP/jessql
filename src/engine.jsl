--!strict
--!native

local data = require('@dream/data')
local parser = require('@jessql/parser')

--- A row: its cells by column name, each holding whatever its source put there.
export type Row = { [string]: unknown }

--- A row as a provider hands it over. The engine only reads it, so any table keyed by column
--- name is one, whatever its owner knows about its cells.
export type SourceRow = { read [string]: unknown }

--- The rows a provider hands over at once: an array the engine only reads.
export type SourceRows = { read [number]: SourceRow }

--- One predicate the engine pushed down to a provider: `column op value`, the column on the left.
--- `op` is `=`, `!=`, `<>`, `<`, `<=`, `>`, `>=` or `LIKE`; `value` is the literal or the bound
--- parameter the query compared the column with.
export type Constraint = { column: string, op: string, value: unknown }

--- One key of an ordering a provider is asked for: the column, and whether it runs downwards.
export type Order = { column: string, desc: boolean }

--- What a provider's `scan`, `iterate` and `lookup` are handed. Everything but `columns` is a
--- hint a provider may ignore. The engine sets `columns`, `constraints`, `whereComplete` and
--- `allowVolatileRows` on every request; `limit`, `limitHint` and `orderBy` are there only when
--- they apply.
---   columns            the columns the query reads from this table
---   constraints        the predicates on this table simple enough to push down
---   limit              a number of rows the provider may stop after, whatever else it does with
---                      the request, without changing the query's result: OFFSET + LIMIT. It is
---                      there only when nothing after the scan can need another row: one table,
---                      no WHERE, no grouping, aggregate or HAVING, and no ORDER BY
---   limitHint          the same number, on one condition: when `orderBy` is set, the rows come
---                      in that order. It is there whenever `limit` is, and also under an ORDER
---                      BY that `orderBy` carries whole; a provider that does not produce that
---                      order must not stop at it. On the request a `lookup` is handed, it is
---                      how many more rows matching the key the query can still use
---   orderBy            the ordering the query wants, when this table alone decides it
---   whereComplete      whether `constraints` are the whole WHERE of a single-table query
---   allowVolatileRows  whether an iterator may hand out one reused row table
export type Request = {
  columns: { string },
  constraints: { Constraint },
  limit: number?,
  limitHint: number?,
  orderBy: { Order }?,
  whereComplete: boolean,
  allowVolatileRows: boolean,
}

--- A provider's answer to `scan` or `lookup` that says what it took care of. Write the table
--- against this type, by annotating the function that returns it or the local that holds it:
--- left to itself, Luau infers the tag as any string, and a provider returning that is refused.
---   _jessqlScan         the protocol tag, `v1`. A table without it is taken for the rows
---   handledConstraints  every pushed constraint was applied to `rows`
---   handledWhere        the whole WHERE was, which only a request saying `whereComplete` allows
---   ordered             `rows` are in the order the request asked for
export type ScanResult = {
  read _jessqlScan: 'v1',
  read rows: SourceRows,
  read handledConstraints: boolean?,
  read handledWhere: boolean?,
  read ordered: boolean?,
}

--- A provider's lazy answer to `iterate`: `next` hands out rows until it returns nil. The tag is
--- `v1`, and the engine raises for any other; like a `ScanResult`, the table is written against
--- this type. `volatileRows` says `next` reuses one row table, which is allowed only when the
--- request set `allowVolatileRows`; the other flags mean what they do on a `ScanResult`.
export type Iterator = {
  read _jessqlIter: 'v1',
  read next: () -> SourceRow?,
  read volatileRows: boolean?,
  read handledConstraints: boolean?,
  read handledWhere: boolean?,
  read ordered: boolean?,
}

--- A table as the engine sees it: what a registering package implements. `columns` and `scan`
--- are required; `scan` returns the rows, or a `ScanResult` around them.
---   count    the exact number of rows, unfiltered: answers a bare `SELECT COUNT(*)`
---   countFiltered  optional exact count for a fully pushable conjunctive WHERE; nil declines
---                  and falls back to ordinary SQL evaluation
---   indexes  the columns `lookup` can find rows by
---   lookup   the rows whose `column` equals `value`, for an indexed join
---   iterate  a lazy scan, used in place of `scan` to drive a single-table query or an indexed join
export type Provider = {
  read columns: { string },
  read scan: (request: Request) -> SourceRows | ScanResult,
  read count: (() -> number)?,
  read countFiltered: ((request: Request) -> number?)?,
  read indexes: { [string]: boolean }?,
  read lookup: ((column: string, value: unknown, request: Request) -> (SourceRows | ScanResult)?)?,
  read iterate: ((request: Request) -> Iterator)?,
}

--- A query's answer: the result columns in SELECT order, and one row per result, keyed by them.
--- A cell that is NULL is absent from its row.
export type Result = { columns: { string }, rows: { Row }, streamed: boolean? }

--- A query result read a row or a page at a time. `streaming` says whether rows are produced as
--- they are asked for (a single source with no aggregate and no sort left to do), or were all
--- computed when the cursor was opened and are only handed out in pieces. `close` stops the
--- query where it is; a cursor is also closed by being read to its end. After either, `next`
--- answers nil and `page` an empty list. A cursor left open across a write to its source may
--- raise at the next read rather than mix two states.
export type Cursor = {
  columns: { string },
  streaming: () -> boolean,
  next: () -> Row?,
  page: (count: number) -> { Row },
  done: () -> boolean,
  close: () -> (),
}

--- One table of a prepared query, and the columns it is scanned for.
export type ExplainedScan = { table: string, alias: string, columns: { string } }

export type ExplainedJoin = {
  kind: 'inner' | 'left',
  table: string,
  alias: string,
  strategy: 'nested-loop' | 'hash' | 'index-left' | 'index-right',
}

--- How a prepared query will run: the columns each table is scanned for, each join's strategy,
--- whether rows are grouped, whether a single grouping column stands in for the group's first row,
--- the number of distinct aggregates, whether the provider's own `count` answers the query, and
--- the number of parameters.
export type Explanation = {
  scans: { ExplainedScan },
  joins: { ExplainedJoin },
  grouped: boolean,
  compactGroup: boolean,
  aggregateCount: number,
  providerCount: boolean,
  parameterCount: number,
}

--- A prepared query. `run` takes the values for its `?` placeholders, in order, and may be called
--- any number of times; `run` and `explain` are called with a dot.
export type Plan = {
  run: (params: { unknown }?) -> Result,
  open: (params: { unknown }?) -> Cursor,
  explain: () -> Explanation,
  ast: parser.Select,
  columns: { string },
  parameterCount: number,
}

--- A registered table: its name in lower case, and its columns.
export type TableInfo = { name: string, columns: { string } }

--- A database: named providers, and queries over them. `_tables` is the engine's own registry,
--- by lower-cased name.
--- What one query's operators may hold, in rows. Nothing spills yet: an operator that would pass
--- its budget stops the query with an error that names the budget, before memory decides.
--- A field left out is not bounded.
export type Limits = {
  -- Rows of the table a hash join builds its table from.
  joinBuildRows: number?,
  -- Rows a join hands on to the next step.
  joinRows: number?,
  -- Groups a GROUP BY or an aggregate holds.
  groups: number?,
  -- Rows a query without aggregates holds at once, to sort them or to return them all. A
  -- query read through a cursor, or one whose ORDER BY and LIMIT let it keep only the best,
  -- holds fewer or none and is counted for what it holds.
  heldRows: number?,
}
export type Database = {
  _tables: { [string]: Provider },
  _limits: Limits?,
  -- Sets, or with nil removes, the budgets every query of this database runs under.
  limits: (self: Database, limits: Limits?) -> Database,
  register: (self: Database, name: string, provider: Provider) -> Database,
  table: (self: Database, name: string, rows: SourceRows, columns: { string }?) -> Database,
  prepare: (self: Database, sql: string) -> Plan,
  query: (self: Database, sql: string, params: { unknown }?) -> Result,
  tables: (self: Database) -> { TableInfo },
}

-- Bound sources are internal planner state, not the public provider protocol.
type BoundSource = {
  name: string,
  alias: string,
  provider: Provider,
  columns: {string},
  columnMap: {[string]: string},
  columnSet: {[string]: boolean},
  index: number,
}

-- Evaluators accept a provider row or a join context; their actual scalar output is dynamic.
-- The engine refines it only where SQL semantics require a particular primitive operation.
type Evaluator = (unknown, {unknown}?, {unknown}) -> unknown

type AggregateSpec = {
  name: string,
  star: boolean,
  expr: parser.Call,
  argFn: Evaluator?,
  slot: number?,
}
type AggregateColumns = {
  names: {string},
  wantsSum: {[number]: boolean},
  wantsLeast: {[number]: boolean},
  wantsGreatest: {[number]: boolean},
}
type Group = {
  [number]: unknown,
  first: unknown?,
  groupKey: unknown?,
  avgCounts: {[number]: number}?,
}
type OrderFn = {evaluate: Evaluator, desc: boolean}
type Unit = {context: unknown, group: Group?, orderKey: unknown?, order: {unknown}?}
type JoinPlan = {
  strategy: 'nested-loop' | 'hash' | 'index-left' | 'index-right',
  leftSourceIndex: number?,
  leftColumn: string?,
  rightColumn: string?,
}
type BoundConstraint = {sourceIndex: number, column: string, op: string, value: unknown, param: number?}
type WhereTerm = {predicate: Evaluator, sourceIndex: number?, pushable: boolean}
type Lookup = (string, unknown, Request) -> (SourceRows | ScanResult)?
type JoinContext = {SourceRow?}
type JoinIterator = {next: () -> JoinContext?}
type ScanFlags = {read handledConstraints: boolean?, read handledWhere: boolean?, read ordered: boolean?}

local function unwrapScan(scanned: SourceRows | ScanResult): (SourceRows, ScanResult?)
  local envelope = scanned :: ScanResult
  if envelope._jessqlScan == 'v1' then return envelope.rows, envelope end
  return scanned :: SourceRows, nil
end

local function unwrapLookup(scanned: (SourceRows | ScanResult)?): SourceRows?
  if not scanned then return nil end
  local rows = unwrapScan(scanned)
  return rows
end

local engine = {}
local AGG = { COUNT = true, SUM = true, AVG = true, MIN = true, MAX = true }

-- What a key column holds for NULL: `data.argsort` puts it after every number.
local NotNumber = 0 / 0

-- How many numbers of a column an ungrouped aggregate holds before the data plane reduces them.
local AggregateChunk = 256
local Numbers: dream_data_Kind_f64 = data.f64()

-- Making an ungrouped aggregate's columns costs what they save over some fifty rows, which a small
-- table never pays back: a table of fewer rows than `AggregateRows` is read a row at a time, as
-- it always was, and so are the first `AggregateDelay` rows a WHERE keeps of any other.
local AggregateRows = 512
local AggregateDelay = 128

-- How many of an ordering's rows are looked at for keys that repeat before its key columns are
-- sorted.
local OrderSample = 256

-- How many result rows are built key by key after one with a NULL cell, before a row is started
-- as a copy again.
local RowRetry = 64

local function lower(text) return string.lower(text) end

local function hasAggregate(expr: parser.Expr?): boolean
  if expr == nil then return false end
  if expr.tag == 'call' and AGG[expr.name] then return true end
  if expr.tag == 'binary' then return hasAggregate(expr.left) or hasAggregate(expr.right) end
  if expr.tag == 'unary' or expr.tag == 'isnull' then return hasAggregate(expr.expr) end

  return expr.tag == 'call' and any[for argument in expr.args => hasAggregate(argument)]
end

local function sqlTruthy(value) return value ~= nil and value ~= false end

local function like(value: unknown, pattern: unknown): boolean?
  if value == nil or pattern == nil then return nil end
  local textValue = tostring(value)
  local textPattern = tostring(pattern)
  local valueIndex, patternIndex = 1, 1
  local starValueIndex: number? = nil
  local starPatternIndex: number? = nil

  while valueIndex <= #textValue do
    local patternChar = string.sub(textPattern, patternIndex, patternIndex)

    if patternChar == '_' then
      valueIndex += 1
      patternIndex += 1
    elseif patternChar == '%' then
      starPatternIndex = patternIndex + 1
      starValueIndex = valueIndex
      patternIndex += 1
    elseif patternChar ~= '' and string.sub(textValue, valueIndex, valueIndex) == patternChar then
      valueIndex += 1
      patternIndex += 1
    elseif starPatternIndex and starValueIndex then
      starValueIndex += 1
      valueIndex = starValueIndex
      patternIndex = starPatternIndex
    else
      return false
    end
  end

  while string.sub(textPattern, patternIndex, patternIndex) == '%' do patternIndex += 1 end
  return patternIndex > #textPattern
end

local function compileLiteralLike(pattern: unknown): ((unknown) -> boolean?)?
  if type(pattern) ~= 'string' then return nil end
  local firstPercent = string.find(pattern, '%', 1, true)
  local firstUnderscore = string.find(pattern, '_', 1, true)
  if firstUnderscore ~= nil then return nil end

  if firstPercent == nil then
    return function(value)
      if value == nil then return nil end
      return tostring(value) == pattern
    end
  end

  local secondPercent = string.find(pattern, '%', firstPercent + 1, true)
  if secondPercent ~= nil then return nil end

  if firstPercent == #pattern then
    local prefix = string.sub(pattern, 1, -2)
    local length = #prefix

    return function(value)
      if value == nil then return nil end
      value = tostring(value)
      return #value >= length and string.sub(value, 1, length) == prefix
    end
  elseif firstPercent == 1 then
    local suffix = string.sub(pattern, 2)
    local length = #suffix

    return function(value)
      if value == nil then return nil end
      value = tostring(value)
      return #value >= length and string.sub(value, #value - length + 1) == suffix
    end
  end

  return nil
end

local function bindColumn(expr: parser.Column, sources: {BoundSource}): (number, string)
  if expr.sourceIndex ~= nil and expr.boundName ~= nil then return expr.sourceIndex, expr.boundName end
  local name = lower(expr.name)
  local sourceIndex: number? = nil

  if expr.qualifier then
    local qualifier = lower(expr.qualifier)

    for index, source in sources do
      if lower(source.alias) == qualifier or lower(source.name) == qualifier then
        sourceIndex = index
        break
      end
    end

    if not sourceIndex then error('jessql: unknown table/alias ' .. expr.qualifier, 0) end
  else
    local hit: number? = nil

    for index, source in sources do
      if source.columnSet[name] then
        if hit then error('jessql: ambiguous column ' .. expr.name, 0) end
        hit = index
      end
    end

    if not hit then error('jessql: unknown column ' .. expr.name, 0) end
    sourceIndex = hit
  end

  expr.sourceIndex = sourceIndex
  expr.boundName = sources[sourceIndex :: number].columnMap[name] or expr.name
  return sourceIndex :: number, expr.boundName :: string
end

--- `column op value` over one table's row as one function, where `value` is a literal that is
--- not NULL: a WHERE is mostly these, and the general form calls a function for each side
--- before it compares. Nil for an operator that is not a comparison.
local function columnAgainstLiteral(op: string, key: string, value: unknown): Evaluator?
  if op == '=' then
    return function(row, _group, _params)
      local left = (row :: SourceRow)[key]
      return if left == nil then nil else left == value
    end
  elseif op == '!=' or op == '<>' then
    return function(row, _group, _params)
      local left = (row :: SourceRow)[key]
      return if left == nil then nil else left ~= value
    end
  elseif op == '<' then
    return function(row, _group, _params)
      local left = (row :: SourceRow)[key]
      return if left == nil then nil else (left :: number) < (value :: number)
    end
  elseif op == '<=' then
    return function(row, _group, _params)
      local left = (row :: SourceRow)[key]
      return if left == nil then nil else (left :: number) <= (value :: number)
    end
  elseif op == '>' then
    return function(row, _group, _params)
      local left = (row :: SourceRow)[key]
      return if left == nil then nil else (left :: number) > (value :: number)
    end
  elseif op == '>=' then
    return function(row, _group, _params)
      local left = (row :: SourceRow)[key]
      return if left == nil then nil else (left :: number) >= (value :: number)
    end
  end

  return nil
end

--- `column op ?` over one table's row as one function, the parameter read on every call.
local function columnAgainstParam(op: string, key: string, index: number): Evaluator?
  if op == '=' then
    return function(row, _group, params)
      local left, right = (row :: SourceRow)[key], params[index]
      return if left == nil or right == nil then nil else left == right
    end
  elseif op == '!=' or op == '<>' then
    return function(row, _group, params)
      local left, right = (row :: SourceRow)[key], params[index]
      return if left == nil or right == nil then nil else left ~= right
    end
  elseif op == '<' then
    return function(row, _group, params)
      local left, right = (row :: SourceRow)[key], params[index]
      return if left == nil or right == nil then nil else (left :: number) < (right :: number)
    end
  elseif op == '<=' then
    return function(row, _group, params)
      local left, right = (row :: SourceRow)[key], params[index]
      return if left == nil or right == nil then nil else (left :: number) <= (right :: number)
    end
  elseif op == '>' then
    return function(row, _group, params)
      local left, right = (row :: SourceRow)[key], params[index]
      return if left == nil or right == nil then nil else (left :: number) > (right :: number)
    end
  elseif op == '>=' then
    return function(row, _group, params)
      local left, right = (row :: SourceRow)[key], params[index]
      return if left == nil or right == nil then nil else (left :: number) >= (right :: number)
    end
  end

  return nil
end

local function compileExpr(expr: parser.Expr, sources: {BoundSource}, directSingle: boolean, aggregateIds: {[parser.Expr]: number}?): Evaluator
  local tag = expr.tag

  if expr.tag == 'literal' then
    local value = expr.value
    return function(_context, _group, _params) return value end
  elseif expr.tag == 'param' then
    local index = expr.index
    return function(_context, _group, params) return params[index] end
  elseif expr.tag == 'column' then
    local sourceIndex, boundName = bindColumn(expr, sources)
    local key = boundName
    local slot = sourceIndex

    if directSingle then
      return function(row, _group, _params) return (row :: SourceRow)[key] end
    end

    return function(context, _group, _params)
      local row = (context :: {SourceRow?})[slot]
      return if row == nil then nil else row[key]
    end
  elseif expr.tag == 'unary' then
    local operand = compileExpr(expr.expr, sources, directSingle, aggregateIds)

    if expr.op == 'NOT' then
      return function(context, group, params)
        local value = operand(context, group, params)
        return if value == nil then nil else not sqlTruthy(value)
      end
    end

    if expr.op == '-' then
      return function(context, group, params)
        local value = operand(context, group, params)
        return if value == nil then nil else -(value :: number)
      end
    end

    return function(context, group, params) return operand(context, group, params) end
  elseif expr.tag == 'isnull' then
    local operand = compileExpr(expr.expr, sources, directSingle, aggregateIds)

    if expr.negated then
      return function(context, group, params) return operand(context, group, params) ~= nil end
    end

    return function(context, group, params) return operand(context, group, params) == nil end
  elseif expr.tag == 'binary' then
    local leftOperand = compileExpr(expr.left, sources, directSingle, aggregateIds)
    local rightOperand = compileExpr(expr.right, sources, directSingle, aggregateIds)
    local op = expr.op

    if directSingle and expr.left.tag == 'column' then
      local right = expr.right
      local fused = nil

      if right.tag == 'literal' and right.value ~= nil then
        fused = columnAgainstLiteral(op, expr.left.boundName :: string, right.value)
      elseif right.tag == 'param' then
        fused = columnAgainstParam(op, expr.left.boundName :: string, right.index)
      end

      if fused then return fused end
    end

    if op == 'AND' then
      return function(context, group, params)
        local left = leftOperand(context, group, params)
        if left == false then return false end
        local right = rightOperand(context, group, params)
        if right == false then return false end
        if left == nil or right == nil then return nil end
        return sqlTruthy(left) and sqlTruthy(right)
      end
    end

    if op == 'OR' then
      return function(context, group, params)
        local left = leftOperand(context, group, params)
        if sqlTruthy(left) then return true end
        local right = rightOperand(context, group, params)
        if sqlTruthy(right) then return true end
        if left == nil or right == nil then return nil end
        return false
      end
    end

    if op == '=' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return left == right
      end
    end

    if op == '!=' or op == '<>' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return left ~= right
      end
    end

    if op == '<' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) < (right :: number)
      end
    end

    if op == '<=' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) <= (right :: number)
      end
    end

    if op == '>' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) > (right :: number)
      end
    end

    if op == '>=' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) >= (right :: number)
      end
    end

    if op == '+' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) + (right :: number)
      end
    end

    if op == '-' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) - (right :: number)
      end
    end

    if op == '*' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) * (right :: number)
      end
    end

    if op == '/' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) / (right :: number)
      end
    end

    if op == '%' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return (left :: number) % (right :: number)
      end
    end

    if op == '||' then
      return function(context, group, params)
        local left, right = leftOperand(context, group, params), rightOperand(context, group, params)
        if left == nil or right == nil then return nil end
        return tostring(left) .. tostring(right)
      end
    end

    if op == 'LIKE' then
      if expr.right.tag == 'literal' then
        local fast = compileLiteralLike(expr.right.value)

        if fast ~= nil then
          return function(context, group, params) return fast(leftOperand(context, group, params)) end
        end
      end

      return function(context, group, params)
        return like(leftOperand(context, group, params), rightOperand(context, group, params))
      end
    end

    error('jessql: unsupported operator ' .. tostring(op), 0)
  elseif expr.tag == 'call' then
    local name = expr.name

    if AGG[name] and aggregateIds then
      local id = aggregateIds[expr]
      if id == nil then error('jessql: aggregate expression was not planned', 0) end
      return function(_context, group, _params) return (group :: {unknown})[id] end
    elseif AGG[name] then
      local arg: Evaluator? = nil

      if not expr.star then
        if #expr.args ~= 1 then error('jessql: aggregate ' .. name .. ' needs one argument', 0) end
        arg = compileExpr(expr.args[1], sources, directSingle, aggregateIds)
      end

      if name == 'COUNT' then
        if expr.star then
          return function(_context, group, _params) return #(group :: {unknown}) end
        end

        return function(_context, group, params)
          local count = 0

          for _, member in group :: {unknown} do
            if (arg :: Evaluator)(member, group, params) ~= nil then count += 1 end
          end

          return count
        end
      elseif name == 'SUM' then
        return function(_context, group, params)
          local total = nil

          for _, member in group :: {unknown} do
            local value = (arg :: Evaluator)(member, group, params)
            if value ~= nil then total = (total or 0) + (value :: number) end
          end

          return total
        end
      elseif name == 'AVG' then
        return function(_context, group, params)
          local total, count = 0, 0

          for _, member in group :: {unknown} do
            local value = (arg :: Evaluator)(member, group, params)

            if value ~= nil then
              total += (value :: number)
              count += 1
            end
          end

          return if count == 0 then nil else total / count
        end
      elseif name == 'MIN' then
        return function(_context, group, params)
          local best = nil

          for _, member in group :: {unknown} do
            local value = (arg :: Evaluator)(member, group, params)
            if value ~= nil and (best == nil or (value :: number) < (best :: number)) then best = value end
          end

          return best
        end
      else
        return function(_context, group, params)
          local best = nil

          for _, member in group :: {unknown} do
            local value = (arg :: Evaluator)(member, group, params)
            if value ~= nil and (best == nil or (value :: number) > (best :: number)) then best = value end
          end

          return best
        end
      end
    end

    local args = [for argument in expr.args => compileExpr(argument, sources, directSingle, aggregateIds)]

    if name == 'LOWER' then
      return function(context, group, params)
        local value = args[1](context, group, params)
        return if value == nil then nil else string.lower(tostring(value))
      end
    elseif name == 'UPPER' then
      return function(context, group, params)
        local value = args[1](context, group, params)
        return if value == nil then nil else string.upper(tostring(value))
      end
    elseif name == 'LENGTH' then
      return function(context, group, params)
        local value = args[1](context, group, params)
        return if value == nil then nil else #tostring(value)
      end
    elseif name == 'ABS' then
      return function(context, group, params)
        local value = args[1](context, group, params)
        return if value == nil then nil else math.abs(value :: number)
      end
    elseif name == 'COALESCE' then
      return function(context, group, params)
        for _, operand in args do
          local value = operand(context, group, params)
          if value ~= nil then return value end
        end

        return nil
      end
    else
      error('jessql: unknown function ' .. name, 0)
    end
  end

  error('jessql: cannot compile expression ' .. tostring(tag), 0)
end

local function schemaFromRows(rows: SourceRows): {string}
  local columns, seen = {}, {}

  for index = 1, math.min(#rows, 32) do
    for key in rows[index] do
      if type(key) == 'string' and not seen[lower(key)] then
        seen[lower(key)] = true
        columns[#columns + 1] = key
      end
    end
  end

  table.sort(columns)
  return columns
end

local function makeSource(db: Database, spec: parser.Source, index: number): BoundSource
  local provider = db._tables[lower(spec.name)]
  if provider == nil then error('jessql: unknown table ' .. spec.name, 0) end
  local columns = provider.columns
  local columnMap, columnSet = {}, {}

  for _, column in columns do
    columnMap[lower(column)] = column
    columnSet[lower(column)] = true
  end

  return {
    name = spec.name,
    alias = spec.alias,
    provider = provider,
    columns = columns,
    columnMap = columnMap,
    columnSet = columnSet,
    index = index,
  }
end

local function constraintFrom(expr: parser.Expr?): ({BoundConstraint}, boolean)
  if expr == nil then return {}, true end
  local out: {BoundConstraint} = {}

  local function walk(node: parser.Expr): boolean
    if node.tag == 'binary' and node.op == 'AND' then return walk(node.left) and walk(node.right) end
    if node.tag ~= 'binary' then return false end
    local op = node.op
    if op ~= '=' and op ~= '!=' and op ~= '<>' and op ~= '<' and op ~= '<=' and op ~= '>' and op ~= '>=' and op ~= 'LIKE' then return false end
    local col, lit = node.left, node.right
    local flip = false

    if col.tag ~= 'column' or (lit.tag ~= 'literal' and lit.tag ~= 'param') then
      col, lit = node.right, node.left
      flip = true
    end

    if col.tag ~= 'column' or (lit.tag ~= 'literal' and lit.tag ~= 'param') or col.sourceIndex == nil then return false end

    if flip then
      if op == '<' then
        op = '>'
      elseif op == '>' then
        op = '<'
      elseif op == '<=' then
        op = '>='
      elseif op == '>=' then
        op = '<='
      end
    end

    out[#out + 1] = {
      sourceIndex = col.sourceIndex, column = col.boundName :: string, op = op,
      value = if lit.tag == 'literal' then lit.value else nil,
      param = if lit.tag == 'param' then lit.index else nil,
    }
    return true
  end

  local complete = walk(expr)
  return out, complete
end

local function conjuncts(expr: parser.Expr?): {parser.Expr}
  local out: {parser.Expr} = {}

  local function walk(node: parser.Expr?)
    if node ~= nil and node.tag == 'binary' and node.op == 'AND' then
      walk(node.left)
      walk(node.right)
    elseif node ~= nil then
      out[#out + 1] = node
    end
  end

  walk(expr)
  return out
end

local function singleSourceOf(expr: parser.Expr?): number?
  local source: number? = nil
  local mixed = false

  local function walk(node: parser.Expr?)
    if node == nil or mixed then return end

    if node.tag == 'column' then
      local sourceIndex = node.sourceIndex

      if sourceIndex ~= nil then
        if not source then
          source = sourceIndex
        elseif source ~= sourceIndex then
          mixed = true
        end
      end
    elseif node.tag == 'binary' then
      walk(node.left)
      walk(node.right)
    elseif node.tag == 'unary' or node.tag == 'isnull' then
      walk(node.expr)
    elseif node.tag == 'call' then
      for _, argument in node.args do walk(argument) end
    end
  end

  walk(expr)
  return if mixed then nil else source
end

local function valueKey(value: unknown): string
  if value == nil then return 'N;' end
  if type(value) == 'string' then return 'S' .. #value .. ':' .. value end
  if type(value) == 'number' then return 'D' .. tostring(value) .. ';' end
  if type(value) == 'boolean' then return if value then 'B1;' else 'B0;' end
  return 'O' .. tostring(value) .. ';'
end

--- The aggregates of an ungrouped query over one table, each of a column or COUNT(*), as two
--- functions. `feed` takes a row: each column's number goes into a chunk that the data plane
--- reduces whole when it fills, with the running sum, least and greatest carried in as the
--- chunk's first element, so every result is the one a row at a time gives: a sum adds in row
--- order from zero, and the least and the greatest are the first that nothing after is below or
--- above. `feed` answers false and takes nothing for a row it does not read this way: one with a
--- metatable, whose cells are read once for each aggregate and in their order, or one holding
--- anything but a number or NULL in a column. `finish` leaves `group` as a row at a time would
--- have left it after the rows fed, for the results to be read or `accumulate` to go on from.
--- The rows `accumulate` has put into `group` already are gone on from in turn. Both functions
--- are nil when a sum, least or greatest of those rows is not a number, which no column of
--- numbers goes on from.
local function columnAccumulator(group: Group, aggregateSpecs: {AggregateSpec}, columns: AggregateColumns, retain: (unknown) -> unknown): (((SourceRow) -> boolean)?, (() -> ())?)
  local {names, wantsSum, wantsLeast, wantsGreatest} = columns
  local held = table.create(#names, 0)
  local counts = table.create(#names, 0)
  local sums = table.create(#names, 0)
  local least, greatest = {} :: {[number]: number}, {} :: {[number]: number}
  local rowCount = 0

  for index, spec in aggregateSpecs do
    local slot, gathered = spec.slot :: number, group[index]

    if spec.star then
      rowCount = gathered :: number
    elseif spec.name == 'COUNT' then
      counts[slot] = gathered :: number
    elseif gathered == nil then
      continue
    elseif type(gathered) ~= 'number' then
      return nil, nil
    elseif spec.name == 'AVG' then
      sums[slot], counts[slot] = gathered :: number, (group.avgCounts :: {[number]:number})[index]
    elseif spec.name == 'SUM' then
      -- A sum that is there has added a cell; how many is asked only of a COUNT or an AVG.
      sums[slot], counts[slot] = gathered :: number, math.max(counts[slot], 1)
    elseif spec.name == 'MIN' then
      least[slot] = gathered
    else
      greatest[slot] = gathered
    end
  end

  local chunks = [for _ in names => buffer.create((AggregateChunk + 1) * 8)]

  local function reduce(slot: number)
    local count = held[slot]
    if count == 0 then return end

    local chunk: buffer = chunks[slot]
    local numbers: dream_data_Kind_f64 = Numbers

    if wantsSum[slot] then
      buffer.writef64(chunk, 0, sums[slot])
      local total = numbers:sum(chunk, 0, count + 1)
      sums[slot] = total
    end

    if wantsLeast[slot] then
      local carried = least[slot]
      local first = if carried == nil then 1 else 0
      if carried ~= nil then buffer.writef64(chunk, 0, carried) end

      local lowest = numbers:min(chunk, first * 8, count + 1 - first)
      least[slot] = lowest
    end

    if wantsGreatest[slot] then
      local carried = greatest[slot]
      local first = if carried == nil then 1 else 0
      if carried ~= nil then buffer.writef64(chunk, 0, carried) end

      local highest = numbers:max(chunk, first * 8, count + 1 - first)
      greatest[slot] = highest
    end

    counts[slot] += count
    held[slot] = 0
  end

  local function feed(row: SourceRow): boolean
    if type(row) ~= 'table' or getmetatable(row :: {}) ~= nil then return false end

    for slot, name in names do
      local value = row[name]

      if type(value) == 'number' then
        if held[slot] == AggregateChunk then reduce(slot) end

        local count = held[slot] + 1
        buffer.writef64(chunks[slot], count * 8, value)
        held[slot] = count
      elseif value ~= nil then
        for earlier = 1, slot - 1 do
          if row[names[earlier]] ~= nil then held[earlier] -= 1 end
        end

        return false
      end
    end

    if group.first == nil then group.first = retain(row) end

    rowCount += 1
    return true
  end

  local function finish()
    for slot in names do
      reduce(slot)
    end

    for index, spec in aggregateSpecs do
      local slot = spec.slot :: number

      if spec.star then
        group[index] = rowCount
      elseif spec.name == 'COUNT' then
        group[index] = counts[slot]
      elseif spec.name == 'AVG' then
        group[index] = sums[slot]
        local avgCounts = group.avgCounts :: {[number]: number}
        avgCounts[index] = counts[slot]
      elseif spec.name == 'SUM' then
        if counts[slot] > 0 then group[index] = sums[slot] end
      elseif spec.name == 'MIN' then
        group[index] = least[slot]
      else
        group[index] = greatest[slot]
      end
    end
  end

  return feed, finish
end

--- Whether the ORDER BY keys `leftKeys` go before `rightKeys`: NULL before every value when a key
--- runs upwards and after every value when it runs downwards. Raises for values that do not
--- compare with each other.
local function keysBefore(orderFns: {OrderFn}, leftKeys: {unknown}, rightKeys: {unknown}): boolean
  for index, order in orderFns do
    local leftKey, rightKey = leftKeys[index], rightKeys[index]
    if leftKey == rightKey then continue end
    if leftKey == nil then return not order.desc end
    if rightKey == nil then return order.desc end
    if order.desc then return (leftKey :: number) > (rightKey :: number) end

    return (leftKey :: number) < (rightKey :: number)
  end

  return false
end

--- The key a column holds as `stored`: NaN for NULL, and a number negated when the key runs
--- downwards, so that every column sorts upwards.
local function keyOf(stored: number, desc: boolean): number?
  if stored ~= stored then return nil end

  return if desc then -stored else stored
end

--- A stable ordering of the first `count` keys of a column, as positions. `data.argsort` puts
--- NaN, which is NULL, last: where it goes downwards. Upwards it is moved to the front.
local function orderOfKeys(keys: buffer, count: number, desc: boolean): buffer
  local order = buffer.create(count * 4)
  data.argsort(keys, 'f64', 0, count, order)
  if desc then return order end

  local valueCount = data.countWhere(keys, 'f64', 0, count, 'le', math.huge)
  if valueCount == count then return order end

  local nullCount = count - valueCount
  local nullsFirst = buffer.create(count * 4)
  buffer.copy(nullsFirst, 0, order, valueCount * 4, nullCount * 4)
  buffer.copy(nullsFirst, nullCount * 4, order, 0, valueCount * 4)
  return nullsFirst
end

--- The positions of the first `count` rows of the key `columns` in ORDER BY order: one stable
--- pass per key, from the last key to the first, so rows whose keys are all equal stay in the
--- order they are held in.
local function orderOfColumns(columns: { buffer }, orderFns: {OrderFn}, count: number): buffer
  local keyCount = #columns
  local order = orderOfKeys(columns[keyCount], count, orderFns[keyCount].desc)
  if keyCount == 1 then return order end

  local gathered = buffer.create(count * 8)

  for keyIndex = keyCount - 1, 1, -1 do
    data.gather(columns[keyIndex], 'f64', 0, count, order, gathered, 0, count)
    local pass = orderOfKeys(gathered, count, orderFns[keyIndex].desc)
    local composed = buffer.create(count * 4)
    data.gather(order, 'u32', 0, count, pass, composed, 0, count)
    order = composed
  end

  return order
end

local function sameContext(context: unknown): unknown return context end

--- Whether two rows that stand next to each other in `order` have every key equal, NULL equal
--- to NULL: the one case in which the order of a sort is the sort's own choice.
local function hasEqualNeighbours(columns: { buffer }, order: buffer, count: number): boolean
  for position = 1, count - 1 do
    local before, after = buffer.readu32(order, (position - 1) * 4) * 8, buffer.readu32(order, position * 4) * 8
    local equal = true

    for _, keys in columns do
      local left, right = buffer.readf64(keys, before), buffer.readf64(keys, after)

      if left ~= right and (left == left or right == right) then
        equal = false
        break
      end
    end

    if equal then return true end
  end

  return false
end

--- Whether some of the rows held as key `columns` have every key the same, bit for bit, among
--- up to `OrderSample` of them spread over the `count`: a cheap sign that the keys repeat.
local function sampleRepeats(columns: { buffer }, count: number): boolean
  local keyCount = #columns
  local together = buffer.create(keyCount * 8)
  local seen = {}

  for position = 0, count - 1, math.max(1, count // OrderSample) do
    for keyIndex, keys in columns do
      buffer.copy(together, (keyIndex - 1) * 8, keys, position * 8, 8)
    end

    local key = buffer.tostring(together)
    if seen[key] then return true end

    seen[key] = true
  end

  return false
end

--- Gives every unit the keys the comparator reads, `order`, or `orderKey` when there is one
--- key: out of the key `columns` for what a numeric ordering had read when it met `key`, a value
--- that is neither a number nor NULL, as key `failedKey` of unit `failedUnit`; read now for the
--- rest. Nothing is read twice. A `failedUnit` past the last unit takes every key out of the
--- columns.
local function restoreOrderKeys(units: {Unit}, orderFns: {OrderFn}, params: {unknown}, columns: { buffer }, failedUnit: number, failedKey: number, key: unknown)
  local keyCount = #orderFns

  if keyCount == 1 then
    local order = orderFns[1]

    for unitIndex, unit in units do
      if unitIndex < failedUnit then
        unit.orderKey = keyOf(buffer.readf64(columns[1], (unitIndex - 1) * 8), order.desc)
      elseif unitIndex == failedUnit then
        unit.orderKey = key
      else
        unit.orderKey = order.evaluate(unit.context, unit.group, params)
      end
    end

    return
  end

  for unitIndex, unit in units do
    local keys = table.create(keyCount)
    local stored = if unitIndex < failedUnit then keyCount elseif unitIndex == failedUnit then failedKey - 1 else 0

    for keyIndex, order in orderFns do
      if keyIndex <= stored then
        keys[keyIndex] = keyOf(buffer.readf64(columns[keyIndex], (unitIndex - 1) * 8), order.desc)
      elseif unitIndex == failedUnit and keyIndex == failedKey then
        keys[keyIndex] = key
      else
        keys[keyIndex] = order.evaluate(unit.context, unit.group, params)
      end
    end

    unit.order = keys
  end
end

--- Whether a unit goes before another by their one key, `orderKey`.
local function oneKeyBefore(desc: boolean): (Unit, Unit) -> boolean
  return function(left, right)
    local leftKey, rightKey = left.orderKey, right.orderKey
    if leftKey == rightKey then return false end
    if leftKey == nil then return not desc end
    if rightKey == nil then return desc end
    if desc then return (leftKey :: number) > (rightKey :: number) end

    return (leftKey :: number) < (rightKey :: number)
  end
end

--- Whether a unit goes before another by their keys, `order`.
local function manyKeysBefore(orderFns: {OrderFn}): (Unit, Unit) -> boolean
  return function(left, right)
    for index, order in orderFns do
      local leftKey, rightKey = (left.order :: {unknown})[index], (right.order :: {unknown})[index]
      if leftKey == rightKey then continue end
      if leftKey == nil then return not order.desc end
      if rightKey == nil then return order.desc end
      if order.desc then return (leftKey :: number) > (rightKey :: number) end

      return (leftKey :: number) < (rightKey :: number)
    end

    return false
  end
end

--- Gives every unit, as its `orderKey`, the place of its keys among all the units' keys, which
--- `order` holds sorted: units whose keys are all equal share a place, so a comparator over the
--- places answers for any two units what one over their keys answers.
local function placeUnits(units: {Unit}, columns: { buffer }, order: buffer, count: number)
  local place, before = 0, -1

  for position = 0, count - 1 do
    local unitIndex = buffer.readu32(order, position * 4)
    local offset = unitIndex * 8

    if before >= 0 then
      for _, keys in columns do
        local left, right = buffer.readf64(keys, before), buffer.readf64(keys, offset)

        if left ~= right and (left == left or right == right) then
          place += 1
          break
        end
      end
    end

    units[unitIndex + 1].orderKey = place
    before = offset
  end
end

--- Whether a unit goes before another by the place of its keys, `orderKey`.
local function placeBefore(left: Unit, right: Unit): boolean return (left.orderKey :: number) < (right.orderKey :: number) end

--- `units` in ORDER BY order, each unit's keys read once and in order. Keys that are all
--- numbers or NULL go into one f64 column each and are sorted by `orderOfColumns`: that order is
--- the comparator's when no two units have every key equal. When two do, the units are sorted
--- by `table.sort` as they always were, so that units with equal keys come back in the order
--- they always have: under a comparator that reads each unit's place in the sorted columns, and
--- so answers as the one over the keys does, or under the one over the keys itself. Keys of any
--- other kind, NaN included, are sorted under the comparator over the keys.
local function orderUnits(units: {Unit}, orderFns: {OrderFn}, params: {unknown}): {Unit}
  local count, keyCount = #units, #orderFns
  local columns = [for _ in orderFns => buffer.create(count * 8)]
  local numeric = true

  for unitIndex, unit in units do
    local offset = (unitIndex - 1) * 8

    for keyIndex, order in orderFns do
      local key = order.evaluate(unit.context, unit.group, params)

      if type(key) == 'number' and key == key then
        buffer.writef64(columns[keyIndex], offset, if order.desc then -key else key)
      elseif key == nil then
        buffer.writef64(columns[keyIndex], offset, NotNumber)
      else
        restoreOrderKeys(units, orderFns, params, columns, unitIndex, keyIndex, key)
        numeric = false
        break
      end
    end

    if not numeric then break end
  end

  -- One key that repeats is sorted no faster by its place than by itself, so the columns are
  -- left unsorted when a sample of them says it does.
  if numeric and keyCount == 1 and sampleRepeats(columns, count) then
    restoreOrderKeys(units, orderFns, params, columns, count + 1, 0, nil)
  elseif numeric then
    local order = orderOfColumns(columns, orderFns, count)
    if not hasEqualNeighbours(columns, order, count) then return [for position in order[1:count, 'u32'] => units[position + 1]] end

    placeUnits(units, columns, order, count)
    table.sort(units, placeBefore)
    return units
  end

  table.sort(units, if keyCount == 1 then oneKeyBefore(orderFns[1].desc) else manyKeysBefore(orderFns))
  return units
end

--- The first `keep` rows of an ORDER BY, as two functions: `offer` takes a row's context and
--- group, and `finish` hands the rows kept back as units, in order. They are kept on a heap
--- under the comparator, as they always were: a row enters when it goes before the last one
--- kept, and which of two rows with equal keys is kept, and in what order, is what the heap and
--- `table.sort` make of them. A row's keys are read once and in order, and it becomes a unit,
--- its context passed through `retain`, only when it enters.
local function boundedOrdering(orderFns: {OrderFn}, params: {unknown}, keep: number, retain: (unknown) -> unknown):
  ((unknown, Group?) -> (), () -> {Unit})
  local heap: {Unit} = table.create(keep) :: {Unit}

  -- The heap's moves are written out for one key and for several: each calls its comparator by
  -- name, which Luau compiles into the loop, where one picked at run time is called every step.
  if #orderFns == 1 then
    local evaluate, desc = orderFns[1].evaluate, orderFns[1].desc

    local function before(left: Unit, right: Unit): boolean
      local leftKey, rightKey = left.orderKey, right.orderKey
      if leftKey == rightKey then return false end
      if leftKey == nil then return not desc end
      if rightKey == nil then return desc end
      if desc then return (leftKey :: number) > (rightKey :: number) end

      return (leftKey :: number) < (rightKey :: number)
    end

    local function siftUp(index)
      while index > 1 do
        local parent = index // 2
        if not before(heap[parent], heap[index]) then break end

        heap[index], heap[parent] = heap[parent], heap[index]
        index = parent
      end
    end

    local function siftDown(index)
      while true do
        local left = index * 2
        if left > #heap then return end

        local right = left + 1
        local worst = left
        if right <= #heap and before(heap[left], heap[right]) then worst = right end
        if not before(heap[index], heap[worst]) then return end

        heap[index], heap[worst] = heap[worst], heap[index]
        index = worst
      end
    end

    local function offer(context: unknown, group: Group?)
      local key = evaluate(context, group, params)
      local size = #heap

      if size < keep then
        heap[size + 1] = { context = retain(context), group = group, orderKey = key }
        siftUp(size + 1)
        return
      end

      local last = heap[1].orderKey

      -- Most rows offered to a full heap are numbers that do not go before the last one kept.
      if type(key) == 'number' and type(last) == 'number' then
        if not (if desc then (key :: number) > (last :: number) else (key :: number) < (last :: number)) then return end
      elseif key == last then
        return
      elseif key == nil then
        if desc then return end
      elseif last == nil then
        if not desc then return end
      elseif not (if desc then (key :: number) > (last :: number) else (key :: number) < (last :: number)) then
        return
      end

      heap[1] = { context = retain(context), group = group, orderKey = key }
      siftDown(1)
    end

    local function finish()
      table.sort(heap, before)
      return heap
    end

    return offer, finish
  end

  local pending: {unknown} = table.create(#orderFns)

  local function before(left: Unit, right: Unit): boolean
    for index, order in orderFns do
      local leftKey, rightKey = (left.order :: {unknown})[index], (right.order :: {unknown})[index]
      if leftKey == rightKey then continue end
      if leftKey == nil then return not order.desc end
      if rightKey == nil then return order.desc end
      if order.desc then return (leftKey :: number) > (rightKey :: number) end

      return (leftKey :: number) < (rightKey :: number)
    end

    return false
  end

  local function siftUp(index)
    while index > 1 do
      local parent = index // 2
      if not before(heap[parent], heap[index]) then break end

      heap[index], heap[parent] = heap[parent], heap[index]
      index = parent
    end
  end

  local function siftDown(index)
    while true do
      local left = index * 2
      if left > #heap then return end

      local right = left + 1
      local worst = left
      if right <= #heap and before(heap[left], heap[right]) then worst = right end
      if not before(heap[index], heap[worst]) then return end

      heap[index], heap[worst] = heap[worst], heap[index]
      index = worst
    end
  end

  local function offer(context: unknown, group: Group?)
    for keyIndex, order in orderFns do
      pending[keyIndex] = order.evaluate(context, group, params)
    end

    local size = #heap
    if size >= keep and not keysBefore(orderFns, pending, heap[1].order :: {unknown}) then return end

    local unit: Unit = { context = retain(context), group = group, order = table.clone(pending) }

    if size < keep then
      heap[size + 1] = unit
      siftUp(size + 1)
    else
      heap[1] = unit
      siftDown(1)
    end
  end

  local function finish()
    table.sort(heap, before)
    return heap
  end

  return offer, finish
end

local function prepare(db: Database, sql: string): Plan
  local ast = parser.parse(sql)
  local sources = { makeSource(db, ast.from, 1) }
  for index, join in ast.joins do sources[#sources + 1] = makeSource(db, join.source, index + 1) end
  local directSingle = #sources == 1

  if hasAggregate(ast.where) then error('jessql: aggregates are not allowed in WHERE', 0) end

  for _, node in ast.groupBy do
    if hasAggregate(node) then error('jessql: aggregates are not allowed in GROUP BY', 0) end
  end

  for _, join in ast.joins do
    if hasAggregate(join.on) then error('jessql: aggregates are not allowed in JOIN ON', 0) end
  end

  local aggregateIds: {[parser.Expr]: number} = {}
  local aggregateSpecs: {AggregateSpec} = {}
  local aggregateByKey: {[string]: number} = {}

  local function exprKey(node: parser.Expr?): string
    if node == nil then return 'nil' end
    if node.tag == 'literal' then return 'lit:' .. type(node.value) .. ':' .. tostring(node.value) end
    if node.tag == 'param' then return 'param:' .. tostring(node.index) end
    if node.tag == 'column' then return 'col:' .. lower(node.qualifier or '') .. '.' .. lower(node.name) end
    if node.tag == 'star' then return 'star:' .. lower(node.qualifier or '') end
    if node.tag == 'unary' then return 'u:' .. node.op .. '(' .. exprKey(node.expr) .. ')' end
    if node.tag == 'isnull' then return 'null:' .. tostring(node.negated) .. '(' .. exprKey(node.expr) .. ')' end
    if node.tag == 'binary' then return 'b:' .. node.op .. '(' .. exprKey(node.left) .. ',' .. exprKey(node.right) .. ')' end

    if node.tag == 'call' then
      local parts = [for argument in node.args => exprKey(argument)]
      return 'call:' .. node.name .. ':' .. tostring(node.star) .. '(' .. table.concat(parts, ',') .. ')'
    end

    return tostring(node.tag)
  end

  local function registerAggregates(node: parser.Expr?)
    if node == nil then return end

    if node.tag == 'call' and AGG[node.name] then
      local key = exprKey(node)
      local id = aggregateByKey[key]

      if id == nil then
        id = #aggregateSpecs + 1
        aggregateByKey[key] = id
        aggregateSpecs[id] = { name = node.name, star = node.star, expr = node }
      end

      aggregateIds[node] = id
      return
    elseif node.tag == 'binary' then
      registerAggregates(node.left)
      registerAggregates(node.right)
    elseif node.tag == 'unary' or node.tag == 'isnull' then
      registerAggregates(node.expr)
    elseif node.tag == 'call' then
      for _, argument in node.args do registerAggregates(argument) end
    end
  end

  for _, item in ast.select do registerAggregates(item.expr) end
  registerAggregates(ast.having)
  for _, order in ast.orderBy do registerAggregates(order.expr) end

  local whereFn = if ast.where then compileExpr(ast.where, sources, directSingle, nil) else nil
  local whereTermPlans: {WhereTerm} = {}

  if ast.where ~= nil then
    for _, term in conjuncts(ast.where) do
      local _, pushable = constraintFrom(term)
      whereTermPlans[#whereTermPlans + 1] = {
        predicate = compileExpr(term, sources, directSingle, nil),
        sourceIndex = singleSourceOf(term),
        pushable = pushable,
      }
    end
  end

  local sourceWhereFns: {[number]: (SourceRow, {unknown}) -> boolean} = {}

  if #sources > 1 and ast.where ~= nil then
    local bySource: {[number]: {Evaluator}} = {}

    for _, term in conjuncts(ast.where) do
      local sourceIndex = singleSourceOf(term)
      if sourceIndex == nil then continue end
      local list = bySource[sourceIndex]

      if list == nil then
        list = {}
        bySource[sourceIndex] = list
      end

      list[#list + 1] = compileExpr(term, sources, true, nil)
    end

    for sourceIndex, list in bySource do
      if list ~= nil then
        sourceWhereFns[sourceIndex] = function(row, params) return all[for predicate in list => sqlTruthy(predicate(row, nil, params))] end
      end
    end
  end

  local function sourceFilterScore(sourceIndex)
    return sum[for term in whereTermPlans if term.sourceIndex == sourceIndex => if term.pushable then 2 else 1]
  end

  local joinFns: {Evaluator} = {}
  local joinPlans: {JoinPlan} = {}

  for index, join in ast.joins do
    joinFns[index] = compileExpr(join.on, sources, directSingle, nil)
    local rightIndex = index + 1
    local node = join.on
    local plan: JoinPlan = { strategy = 'nested-loop' }

    if node.tag == 'binary' and node.op == '=' and node.left.tag == 'column' and node.right.tag == 'column' then
      local leftCol, rightCol = node.left, node.right
      if leftCol.sourceIndex == rightIndex and (rightCol.sourceIndex :: number) < rightIndex then leftCol, rightCol = rightCol, leftCol end

      if (leftCol.sourceIndex :: number) < rightIndex and rightCol.sourceIndex == rightIndex then
        plan.strategy = 'hash'
        plan.leftSourceIndex = leftCol.sourceIndex
        plan.leftColumn = leftCol.boundName
        plan.rightColumn = rightCol.boundName

        if #sources == 2 and #ast.joins == 1 and join.kind == 'inner' then
          local leftProvider = sources[leftCol.sourceIndex :: number].provider
          local rightProvider = sources[rightIndex].provider
          local leftIndexed = leftCol.sourceIndex == 1 and type(leftProvider.lookup) == 'function'
            and type(leftProvider.indexes) == 'table' and leftProvider.indexes[leftCol.boundName :: string] == true
          local rightIndexed = type(rightProvider.lookup) == 'function'
            and type(rightProvider.indexes) == 'table' and rightProvider.indexes[rightCol.boundName :: string] == true

          if leftIndexed and rightIndexed then
            local leftScore = sourceFilterScore(leftCol.sourceIndex :: number)
            local rightScore = sourceFilterScore(rightIndex)
            plan.strategy = (if leftScore > rightScore then 'index-right' else 'index-left') :: ('index-right' | 'index-left')
          elseif leftIndexed then
            plan.strategy = 'index-left' :: 'index-left'
          elseif rightIndexed then
            plan.strategy = 'index-right' :: 'index-right'
          end
        end
      end
    end

    joinPlans[index] = plan
  end

  local groupFns = [for node in ast.groupBy => compileExpr(node, sources, directSingle, nil)]

  for _, spec in aggregateSpecs do
    if spec.star then
      if spec.name ~= 'COUNT' then error('jessql: only COUNT accepts *', 0) end
    else
      if #spec.expr.args ~= 1 then error('jessql: aggregate ' .. spec.name .. ' needs one argument', 0) end
      spec.argFn = compileExpr(spec.expr.args[1], sources, directSingle, nil)
    end
  end

  -- An ungrouped query over one table whose aggregates are each of a column, or COUNT(*), reads
  -- every column once a row and has the data plane reduce it: `aggregateColumns` is the columns,
  -- and which of the sum, the least and the greatest is wanted of each, by its slot.
  local aggregateColumns: AggregateColumns = { names = {}, wantsSum = {}, wantsLeast = {}, wantsGreatest = {} }

  for _, spec in aggregateSpecs do
    local argument = spec.expr.args[1]
    if spec.star or not directSingle or argument == nil or argument.tag ~= 'column' then continue end

    local slot: number? = table.find(aggregateColumns.names, argument.boundName :: string)

    if not slot then
      table.insert(aggregateColumns.names, argument.boundName :: string)
      slot = #aggregateColumns.names
    end

    spec.slot = slot :: number
    if spec.name == 'SUM' or spec.name == 'AVG' then aggregateColumns.wantsSum[slot :: number] = true end
    if spec.name == 'MIN' then aggregateColumns.wantsLeast[slot :: number] = true end
    if spec.name == 'MAX' then aggregateColumns.wantsGreatest[slot :: number] = true end
  end

  local columnAggregates = directSingle and #ast.groupBy == 0 and all[for spec in aggregateSpecs => spec.star or spec.slot ~= nil]

  local havingFn = if ast.having then compileExpr(ast.having, sources, directSingle, aggregateIds) else nil
  local hasAvg = any[for spec in aggregateSpecs => spec.name == 'AVG']

  -- A single simple GROUP BY column can carry its own representative value. If every
  -- non-aggregate column referenced after grouping is that same column, retaining the first
  -- provider/join context per group is pure overhead. Keep permissive first-row semantics for
  -- every other query shape. ORDER BY may reference SELECT aliases, so inspect their defining
  -- expressions instead of mistaking an aggregate alias for a provider column.
  local compactGroupColumn: {sourceIndex: number, column: string}? = nil

  if #ast.groupBy == 1 then
    local grouped = ast.groupBy[1]
    local groupedSource = if grouped.tag == 'column' then grouped.sourceIndex else nil
    if groupedSource == nil and grouped.tag == 'column' and directSingle then groupedSource = 1 end

    if grouped.tag == 'column' and groupedSource ~= nil then
      local groupedName = grouped.boundName or grouped.name
      local selectAliases: {[string]: parser.Expr} = {}

      for _, item in ast.select do
        if item.alias ~= nil then selectAliases[lower(item.alias)] = item.expr end
      end

      local aliasStack: {[parser.Expr]: boolean} = {}
      local safe = true

      local function inspectPostAggregate(expr: parser.Expr?, insideAggregate: boolean)
        if expr == nil or not safe then return end

        if expr.tag == 'column' then
          if not insideAggregate then
            local aliasExpr = nil

            if expr.qualifier == nil and expr.sourceIndex == nil then
              aliasExpr = selectAliases[lower(expr.name)]
            end

            if aliasExpr ~= nil and not aliasStack[aliasExpr] then
              aliasStack[aliasExpr] = true
              inspectPostAggregate(aliasExpr, false)
              aliasStack[aliasExpr] = nil
            else
              local sourceIndex, columnName = bindColumn(expr, sources)
              if sourceIndex ~= groupedSource or columnName ~= groupedName then safe = false end
            end
          end
        elseif expr.tag == 'binary' then
          inspectPostAggregate(expr.left, insideAggregate)
          inspectPostAggregate(expr.right, insideAggregate)
        elseif expr.tag == 'unary' or expr.tag == 'isnull' then
          inspectPostAggregate(expr.expr, insideAggregate)
        elseif expr.tag == 'call' then
          local aggregateCall = AGG[string.upper(expr.name)] == true
          for _, argument in expr.args do inspectPostAggregate(argument, insideAggregate or aggregateCall) end
        end
      end

      for _, item in ast.select do inspectPostAggregate(item.expr, false) end
      inspectPostAggregate(ast.having, false)
      for _, order in ast.orderBy do inspectPostAggregate(order.expr, false) end
      if safe then compactGroupColumn = { sourceIndex = groupedSource, column = groupedName } end
    end
  end

  local selectors: {Evaluator} = {}
  local resultColumns: {string} = {}
  local selectorByAlias: {[string]: Evaluator} = {}
  local selectorSource: {[string]: {sourceIndex: number, column: string}} = {}

  local function addSelector(name: string, selector: Evaluator, sourceInfo: {sourceIndex: number, column: string}?)
    selectors[#selectors + 1] = selector
    resultColumns[#resultColumns + 1] = name
    selectorByAlias[lower(name)] = selector
    selectorSource[lower(name)] = sourceInfo
  end

  for _, item in ast.select do
    local node = item.expr

    if node.tag == 'star' then
      for sourceIndex, source in sources do
        if node.qualifier == nil or lower(node.qualifier) == lower(source.alias) or lower(node.qualifier) == lower(source.name) then
          for _, column in source.columns do
            local key = column
            local slot = sourceIndex
            local selector: Evaluator

            if directSingle then
              selector = function(row) return (row :: SourceRow)[key] end
            else
              selector = function(context)
                local row = (context :: {SourceRow?})[slot]
                return if row then row[key] else nil
              end
            end

            addSelector(if directSingle then column else source.alias .. '.' .. column, selector, { sourceIndex = sourceIndex, column = column })
          end
        end
      end
    else
      local name = item.alias

      if name == nil then
        if node.tag == 'column' then
          name = node.name
        elseif node.tag == 'call' then
          name = string.lower(node.name)
        else
          name = 'expr' .. tostring(#selectors + 1)
        end
      end

      local selector = compileExpr(node, sources, directSingle, aggregateIds)
      local sourceInfo = if node.tag == 'column' and node.sourceIndex ~= nil
        then { sourceIndex = node.sourceIndex, column = node.boundName :: string } else nil
      addSelector(name :: string, selector, sourceInfo)
    end
  end

  -- A result row starts as a copy of this one, which has every result column in it already, so
  -- that filling the row never grows it. Two result columns of one name keep the last value that
  -- is not NULL, and get the row built key by key.
  local rowTemplate: Row? = {}

  for _, name in resultColumns do
    if not rowTemplate or rowTemplate[name] ~= nil then
      rowTemplate = nil
      break
    end

    rowTemplate[name] = false
  end

  local orderFns: {OrderFn} = {}
  local orderSourceInfo: {[number]: {sourceIndex: number, column: string}} = {}

  for index, order in ast.orderBy do
    local evaluate: Evaluator? = nil

    if order.expr.tag == 'column' and order.expr.qualifier == nil then
      local key = lower(order.expr.name)
      evaluate = selectorByAlias[key]
      orderSourceInfo[index] = selectorSource[key]
    end

    if not evaluate then
      evaluate = compileExpr(order.expr, sources, directSingle, aggregateIds)

      if order.expr.tag == 'column' and order.expr.sourceIndex ~= nil then
        orderSourceInfo[index] = { sourceIndex = order.expr.sourceIndex, column = order.expr.boundName :: string }
      end
    end

    orderFns[index] = { evaluate = evaluate :: Evaluator, desc = order.desc }
  end

  local neededSets: {{[string]: boolean}} = [for _ in sources => {}]

  local function markExpr(node: parser.Expr?)
    if node == nil then return end

    if node.tag == 'column' then
      if node.sourceIndex ~= nil then neededSets[node.sourceIndex][node.boundName :: string] = true end
    elseif node.tag == 'star' then
      for sourceIndex, source in sources do
        if node.qualifier == nil or lower(node.qualifier) == lower(source.alias) or lower(node.qualifier) == lower(source.name) then
          for _, column in source.columns do neededSets[sourceIndex][column] = true end
        end
      end
    elseif node.tag == 'binary' then
      markExpr(node.left)
      markExpr(node.right)
    elseif node.tag == 'unary' or node.tag == 'isnull' then
      markExpr(node.expr)
    elseif node.tag == 'call' then
      for _, argument in node.args do markExpr(argument) end
    end
  end

  for _, item in ast.select do markExpr(item.expr) end
  markExpr(ast.where)
  markExpr(ast.having)
  for _, node in ast.groupBy do markExpr(node) end
  for _, order in ast.orderBy do markExpr(order.expr) end
  for _, join in ast.joins do markExpr(join.on) end
  local neededColumns: {{string}} = {}

  for sourceIndex, source in sources do
    local needed = {}

    for _, column in source.columns do
      if neededSets[sourceIndex][column] then needed[#needed + 1] = column end
    end

    neededColumns[sourceIndex] = needed
  end

  local aggregate = #ast.groupBy > 0 or #aggregateSpecs > 0

  -- Exact provider cardinality can answer the simplest COUNT(*) without scanning any rows.
  -- Keep this deliberately narrow: once WHERE/GROUP/HAVING/ORDER/LIMIT/OFFSET participates,
  -- normal SQL execution owns the semantics.
  local directProviderCount = false

  if directSingle and ast.where == nil and #ast.groupBy == 0 and ast.having == nil
    and #ast.orderBy == 0 and ast.limit == nil and ast.offset == 0 and #ast.select == 1
    and type(sources[1].provider.count) == 'function' then
    local expression = ast.select[1].expr
    directProviderCount = expression.tag == 'call' and expression.name == 'COUNT' and expression.star == true
  end

  -- Binding happened while compiling WHERE/select/etc.; extract safe provider hints now.
  local constraints, constraintsComplete = constraintFrom(ast.where)

  -- Exact filtered cardinality is an optional provider fast path. It may decline
  -- a request by returning nil; the general executor then handles the WHERE.
  local directFilteredCount = false

  if directSingle and ast.where ~= nil and constraintsComplete and #ast.groupBy == 0
    and ast.having == nil and #ast.orderBy == 0 and ast.limit == nil and ast.offset == 0
    and #ast.select == 1 and type(sources[1].provider.countFiltered) == 'function' then
    local expression = ast.select[1].expr
    directFilteredCount = expression.tag == 'call' and expression.name == 'COUNT' and expression.star == true
  end

  local providerOrder: {Order}? = nil

  if directSingle and not aggregate and #ast.orderBy > 0 then
    local pushed: {Order} = table.create(#ast.orderBy) :: {Order}
    local ok = true

    for index, order in ast.orderBy do
      local info = orderSourceInfo[index]

      if info == nil or info.sourceIndex ~= 1 then
        ok = false
        break
      end

      pushed[index] = { column = info.column, desc = order.desc }
    end

    if ok then providerOrder = pushed end
  end

  -- How many rows a single table's provider may stop at: OFFSET + LIMIT, the rows the engine
  -- skips included. `providerLimit` holds whatever else the provider does, so it is set only when
  -- nothing after the scan can need another row: no join, no WHERE for the engine to apply, no
  -- grouping, aggregate or HAVING, and no ORDER BY. `providerLimitHint` also holds under an
  -- ORDER BY asked of the provider whole, for a provider that hands its rows over in that order.
  local providerLimit: number? = nil
  local providerLimitHint: number? = nil

  if directSingle and not aggregate and ast.limit ~= nil and ast.where == nil and ast.having == nil then
    local enough = ast.offset + ast.limit
    if #ast.orderBy == 0 then providerLimit = enough end
    if #ast.orderBy == 0 or providerOrder then providerLimitHint = enough end
  end

  local indexedDriverSource: number? = nil
  local indexedDriverOrder: {Order}? = nil

  if #sources == 2 and #joinPlans == 1 then
    if joinPlans[1].strategy == 'index-left' then indexedDriverSource = 2 end
    if joinPlans[1].strategy == 'index-right' then indexedDriverSource = 1 end

    if not aggregate and indexedDriverSource and #ast.orderBy > 0 then
      local pushed: {Order} = table.create(#ast.orderBy) :: {Order}
      local ok = true

      for index, order in ast.orderBy do
        local info = orderSourceInfo[index]

        if info == nil or info.sourceIndex ~= indexedDriverSource then
          ok = false
          break
        end

        pushed[index] = { column = info.column, desc = order.desc }
      end

      if ok then indexedDriverOrder = pushed end
    end
  end

  local plan: Plan = {} :: Plan

  local function execute(params: {unknown}?, sink: ((Row) -> boolean?)?): Result
    local values: {unknown} = params or {}
    if #values < ast.params then error(string.format('jessql: query expects %d parameters, got %d', ast.params, #values), 0) end

    -- Read when the query runs, so a prepared plan obeys the budgets of the moment.
    local limits = db._limits
    local buildLimit = if limits then limits.joinBuildRows else nil
    local joinLimit = if limits then limits.joinRows else nil
    local groupLimit = if limits then limits.groups else nil
    local heldLimit = if limits then limits.heldRows else nil
    local function overBudget(what: string, rows: number, limit: number)
      error(string.format('jessql: query exceeds its budget: %s, %d rows (limit %d)', what, rows, limit), 0)
    end

    if directProviderCount then
      local row: Row = {}
      row[resultColumns[1]] = (sources[1].provider.count :: () -> number)()
      return { columns = resultColumns, rows = { row } }
    end

    if directFilteredCount then
      local sourceConstraints: {Constraint} = [
        for constraint in constraints => {
          column = constraint.column,
          op = constraint.op,
          value = if constraint.param then values[constraint.param :: number] else constraint.value,
        }
      ]

      local request: Request = {
        columns = {}, constraints = sourceConstraints, whereComplete = true,
        allowVolatileRows = false,
      }
      local counted = (sources[1].provider.countFiltered :: (Request) -> number?)(request)
      if counted ~= nil then
        if type(counted) ~= 'number' or counted < 0 or counted % 1 ~= 0 then
          error('jessql: invalid provider filtered count', 0)
        end
        local row: Row = {}
        row[resultColumns[1]] = counted
        return { columns = resultColumns, rows = { row } }
      end
    end

    local rowsBySource: {[number]: SourceRows} = {}
    local rowIterators: {[number]: Iterator} = {}
    local scanMeta: {[number]: ScanFlags} = {}
    local scanRequests: {[number]: Request} = {}
    local skipScan = {}
    local lazyDriver = {}

    if directSingle and type(sources[1].provider.iterate) == 'function' then
      skipScan[1] = true
      lazyDriver[1] = true
    end

    if #sources == 2 and #joinPlans == 1 then
      if joinPlans[1].strategy == 'index-left' then skipScan[1] = true end
      if joinPlans[1].strategy == 'index-right' then skipScan[2] = true end

      if indexedDriverSource and type(sources[indexedDriverSource].provider.iterate) == 'function' then
        skipScan[indexedDriverSource] = true
        lazyDriver[indexedDriverSource] = true
      end
    end

    for sourceIndex, source in sources do
      local sourceConstraints: {Constraint} = [
        for constraint in constraints if constraint.sourceIndex == sourceIndex => {
          column = constraint.column,
          op = constraint.op,
          value = if constraint.param then values[constraint.param :: number] else constraint.value,
        }
      ]

      local request: Request = {
        columns = neededColumns[sourceIndex],
        constraints = sourceConstraints,
        limit = providerLimit,
        limitHint = providerLimitHint,
        orderBy = if directSingle and sourceIndex == 1 then providerOrder
          elseif indexedDriverSource == sourceIndex then indexedDriverOrder
          else nil,
        whereComplete = directSingle and (ast.where == nil or constraintsComplete),
        allowVolatileRows = directSingle,
      }

      scanRequests[sourceIndex] = request

      if lazyDriver[sourceIndex] then
        local iter = (source.provider.iterate :: (Request) -> Iterator)(request)

        if type(iter) ~= 'table' or iter._jessqlIter ~= 'v1' or type(iter.next) ~= 'function' then
          error('jessql: provider iterate(request) must return a v1 iterator', 0)
        end

        rowIterators[sourceIndex] = iter
        scanMeta[sourceIndex] = iter
      elseif not skipScan[sourceIndex] then
        local scanned = source.provider.scan(request)

        local scanRows, scanResult = unwrapScan(scanned)
        rowsBySource[sourceIndex] = scanRows
        if scanResult ~= nil then scanMeta[sourceIndex] = scanResult end

        local sourceWhere = sourceWhereFns[sourceIndex]
        local meta = scanMeta[sourceIndex]

        if sourceWhere ~= nil and not (meta ~= nil and meta.handledConstraints == true) then
          local input = rowsBySource[sourceIndex]
          local filtered = {}

          for _, row in input do
            if sourceWhere(row, values) then filtered[#filtered + 1] = row end
          end

          rowsBySource[sourceIndex] = filtered
        end
      end
    end

    local residualWhere: Evaluator? = whereFn

    if #whereTermPlans > 0 then
      local active: {Evaluator} = {}

      for _, term in whereTermPlans do
        local meta = if term.sourceIndex ~= nil then scanMeta[term.sourceIndex] else nil

        if not (term.pushable and meta ~= nil and meta.handledConstraints == true) then
          active[#active + 1] = term.predicate
        end
      end

      if #active == 0 then
        residualWhere = nil
      elseif #active ~= #whereTermPlans then
        residualWhere = function(context, group, runParams)
          return all[for predicate in active => sqlTruthy(predicate(context, group, runParams))]
        end
      end
    end

    local orderHandled = false

    if directSingle then
      local meta = scanMeta[1]

      if meta ~= nil then
        if meta.handledWhere == true then residualWhere = nil end
        if meta.ordered == true and providerOrder then orderHandled = true end
      end
    end

    local indexedJoinIterator: JoinIterator? = nil

    if not directSingle and #ast.joins == 1 then
      local joinPlan = joinPlans[1]

      if joinPlan.strategy == 'index-left' or joinPlan.strategy == 'index-right' then
        local lookupSource = if joinPlan.strategy == 'index-left' then 1 else 2
        local driverSource = if lookupSource == 1 then 2 else 1
        local lookupColumn = (if lookupSource == 1 then joinPlan.leftColumn else joinPlan.rightColumn) :: string
        local driverColumn = (if driverSource == 1 then joinPlan.leftColumn else joinPlan.rightColumn) :: string
        local provider = sources[lookupSource].provider
        local request = scanRequests[lookupSource]
        local driverIterator = rowIterators[driverSource]
        local driverRows = rowsBySource[driverSource]
        local driverPosition = 0
        local currentDriver: SourceRow? = nil
        local currentMatches: SourceRows? = nil
        local matchPosition = 0
        local lastKey: unknown = nil
        local lastMatches: SourceRows? = nil
        local yielded = 0
        local joinedLimit = if not aggregate and not residualWhere and #orderFns == 0 and ast.limit
          then ast.offset + ast.limit else nil

        local function nextDriver(): SourceRow?
          if driverIterator ~= nil then return driverIterator.next() end
          driverPosition += 1
          if driverRows == nil then return nil end
          return driverRows[driverPosition]
        end

        local function lookupRows(key: unknown): SourceRows
          if key == lastKey then return lastMatches :: SourceRows end
          local lookupRequest = request

          if joinedLimit ~= nil then
            lookupRequest = table.clone(request)
            lookupRequest.limitHint = math.max(joinedLimit - yielded, 0)
          end

          local looked = (provider.lookup :: Lookup)(lookupColumn, key, lookupRequest)
          local rows: SourceRows = unwrapLookup(looked) or {}
          lastKey = key
          lastMatches = rows
          return rows
        end

        indexedJoinIterator = {
          next = function(): JoinContext?
            while true do
              if joinedLimit ~= nil and yielded >= (joinedLimit :: number) then return nil end

              if currentMatches then
                matchPosition += 1
                local matched = (currentMatches :: SourceRows)[matchPosition]

                if matched ~= nil then
                  yielded += 1
                  if lookupSource == 1 then return { matched, currentDriver :: SourceRow } :: JoinContext end
                  return { currentDriver :: SourceRow, matched } :: JoinContext
                end

                currentMatches = nil
              end

              currentDriver = nextDriver()
              if not currentDriver then return nil end
              local key = (currentDriver :: SourceRow)[driverColumn]

              if key ~= nil then
                currentMatches = lookupRows(key)
                matchPosition = 0
              end
            end
          end,
        }
      end
    end

    local contexts: {unknown}? = if directSingle then rowsBySource[1] :: {unknown} else nil

    if not indexedJoinIterator then
      for joinIndex, join in ast.joins do
        local sourceIndex = joinIndex + 1
        local rhs: SourceRows = rowsBySource[sourceIndex]
        local on = joinFns[joinIndex]
        local joinPlan = joinPlans[joinIndex]
        local nextContexts: {JoinContext} = {}

        if joinIndex == 1 and not directSingle and joinPlan.strategy == 'index-left' then
          local provider = sources[1].provider
          local request = scanRequests[1]
          local cache, missing = {}, {}
          local driverMeta = scanMeta[2]
          local driverOrdered = #orderFns == 0 or (indexedDriverOrder ~= nil and driverMeta ~= nil and driverMeta.ordered == true)
          local stopAfter = if driverOrdered and ast.limit ~= nil and not aggregate then ast.offset + ast.limit else nil
          local done = stopAfter == 0

          local function consumeRight(right: SourceRow)
            local key = right[joinPlan.rightColumn :: string]
            if key == nil then return end
            local leftRows = cache[key]

            if leftRows == nil and not missing[key] then
              local lookupRequest = request

              if stopAfter and not residualWhere then
                lookupRequest = table.clone(request)
                lookupRequest.limitHint = stopAfter - #nextContexts
              end

              local looked = (provider.lookup :: Lookup)(joinPlan.leftColumn :: string, key, lookupRequest)

              if looked ~= nil then
                leftRows = unwrapLookup(looked)
              end

              if leftRows == nil or #(leftRows :: SourceRows) == 0 then missing[key] = true else cache[key] = leftRows end
            end

            if leftRows ~= nil then
              for _, leftRow in leftRows do
                local context: JoinContext = { leftRow, right }

                if not residualWhere or sqlTruthy(residualWhere(context, nil, values)) then
                  nextContexts[#nextContexts + 1] = context

                  if stopAfter ~= nil and #nextContexts >= stopAfter then
                    done = true
                    break
                  end
                end
              end
            end
          end

          local driverIter = rowIterators[2]

          if driverIter ~= nil then
            while not done do
              local right = driverIter.next()
              if right == nil then break end
              consumeRight(right)
            end
          else
            for _, right in rowsBySource[2] :: SourceRows do
              if done then break end
              consumeRight(right)
            end
          end

          residualWhere = nil
          if #orderFns > 0 and driverOrdered then orderHandled = true end
        elseif joinIndex == 1 and not directSingle and joinPlan.strategy == 'index-right' then
          local provider = sources[2].provider
          local request = scanRequests[2]
          local cache, missing = {}, {}
          local driverMeta = scanMeta[1]
          local driverOrdered = #orderFns == 0 or (indexedDriverOrder ~= nil and driverMeta ~= nil and driverMeta.ordered == true)
          local stopAfter = if driverOrdered and ast.limit ~= nil and not aggregate then ast.offset + ast.limit else nil
          local done = stopAfter == 0

          local function consumeLeft(leftRow: SourceRow)
            local key = leftRow[joinPlan.leftColumn :: string]
            if key == nil then return end
            local rightRows = cache[key]

            if rightRows == nil and not missing[key] then
              local lookupRequest = request

              if stopAfter and not residualWhere then
                lookupRequest = table.clone(request)
                lookupRequest.limitHint = stopAfter - #nextContexts
              end

              local looked = (provider.lookup :: Lookup)(joinPlan.rightColumn :: string, key, lookupRequest)

              if looked ~= nil then
                rightRows = unwrapLookup(looked)
              end

              if rightRows == nil or #(rightRows :: SourceRows) == 0 then missing[key] = true else cache[key] = rightRows end
            end

            if rightRows ~= nil then
              for _, right in rightRows do
                local context: JoinContext = { leftRow, right }

                if not residualWhere or sqlTruthy(residualWhere(context, nil, values)) then
                  nextContexts[#nextContexts + 1] = context

                  if stopAfter ~= nil and #nextContexts >= stopAfter then
                    done = true
                    break
                  end
                end
              end
            end
          end

          local driverIter = rowIterators[1]

          if driverIter ~= nil then
            while not done do
              local leftRow = driverIter.next()
              if leftRow == nil then break end
              consumeLeft(leftRow)
            end
          else
            for _, leftRow in rowsBySource[1] :: SourceRows do
              if done then break end
              consumeLeft(leftRow)
            end
          end

          residualWhere = nil
          if #orderFns > 0 and driverOrdered then orderHandled = true end
        elseif joinIndex == 1 and not directSingle and joinPlan.strategy == 'hash' then
          if buildLimit and #(rhs :: SourceRows) > buildLimit then overBudget('the build side of a hash join', #(rhs :: SourceRows), buildLimit) end

          local buckets: {[unknown]: SourceRow} = {}
          local duplicateBuckets: {[unknown]: {SourceRow}} = {}

          for _, right in rhs :: SourceRows do
            local key = right[joinPlan.rightColumn :: string]

            if key ~= nil then
              local first = buckets[key]

              if first == nil then
                buckets[key] = right
              else
                local bucket = duplicateBuckets[key]

                if bucket == nil then
                  bucket = { first, right }
                  duplicateBuckets[key] = bucket
                else
                  bucket[#bucket + 1] = right
                end
              end
            end
          end

          for _, leftRow in rowsBySource[1] :: SourceRows do
            local key = leftRow[joinPlan.leftColumn :: string]
            local first = if key == nil then nil else buckets[key]

            if first ~= nil then
              local bucket = duplicateBuckets[key]

              if bucket ~= nil then
                for _, right in bucket do nextContexts[#nextContexts + 1] = { leftRow, right } end
              else
                nextContexts[#nextContexts + 1] = { leftRow, first }
              end
            elseif join.kind == 'left' then
              nextContexts[#nextContexts + 1] = { leftRow }
            end
          end
        elseif joinIndex == 1 and not directSingle then
          for _, leftRow in rowsBySource[1] :: SourceRows do
            local matched = false

            for _, right in rhs :: SourceRows do
              local context: JoinContext = { leftRow, right }

              if sqlTruthy(on(context, nil, values)) then
                nextContexts[#nextContexts + 1] = context
                matched = true
              end
            end

            if not matched and join.kind == 'left' then nextContexts[#nextContexts + 1] = { leftRow } end
          end
        elseif joinPlan.strategy == 'hash' then
          if buildLimit and #(rhs :: SourceRows) > buildLimit then overBudget('the build side of a hash join', #(rhs :: SourceRows), buildLimit) end

          local buckets: {[unknown]: SourceRow} = {}
          local duplicateBuckets: {[unknown]: {SourceRow}} = {}

          for _, right in rhs :: SourceRows do
            local key = right[joinPlan.rightColumn :: string]

            if key ~= nil then
              local first = buckets[key]

              if first == nil then
                buckets[key] = right
              else
                local bucket = duplicateBuckets[key]

                if bucket == nil then
                  bucket = { first, right }
                  duplicateBuckets[key] = bucket
                else
                  bucket[#bucket + 1] = right
                end
              end
            end
          end

          for _, left in contexts :: {JoinContext} do
            local sourceRow = (left :: JoinContext)[joinPlan.leftSourceIndex :: number]
            local key = if sourceRow == nil then nil else sourceRow[joinPlan.leftColumn :: string]
            local first = if key == nil then nil else buckets[key]

            if first ~= nil then
              local bucket = duplicateBuckets[key]

              if bucket ~= nil then
                for _, right in bucket do
                  local context: JoinContext = table.clone(left :: JoinContext)
                  context[sourceIndex] = right
                  nextContexts[#nextContexts + 1] = context
                end
              else
                local right = first
                local context: JoinContext = table.clone(left :: JoinContext)
                context[sourceIndex] = right
                nextContexts[#nextContexts + 1] = context
              end
            elseif join.kind == 'left' then
              local context: JoinContext = table.clone(left :: JoinContext)
              context[sourceIndex] = nil
              nextContexts[#nextContexts + 1] = context
            end
          end
        else
          for _, left in contexts :: {JoinContext} do
            local matched = false

            for _, right in rhs :: SourceRows do
              local context: JoinContext = table.clone(left :: JoinContext)
              context[sourceIndex] = right

              if sqlTruthy(on(context, nil, values)) then
                nextContexts[#nextContexts + 1] = context
                matched = true
              end
            end

            if not matched and join.kind == 'left' then
              local context: JoinContext = table.clone(left :: JoinContext)
              context[sourceIndex] = nil
              nextContexts[#nextContexts + 1] = context
            end
          end
        end

        contexts = nextContexts :: {unknown}
        if joinLimit and #contexts > joinLimit then overBudget('the rows a join hands on', #contexts, joinLimit) end
      end
    end

    -- Single-source providers may stream rows instead of materializing their complete input.
    -- Joins keep the existing materialized/index-driver machinery; direct queries consume the
    -- provider iterator exactly once in the aggregate/projection stage below.
    local directIter = if directSingle then rowIterators[1] else nil
    local volatileContext = directIter ~= nil and directIter.volatileRows == true

    local function retainContext(context: unknown): unknown
      if volatileContext then return table.clone(context :: {}) end
      return context
    end

    local function eachContext(visit: (unknown) -> boolean?)
      if indexedJoinIterator then
        while true do
          local context = indexedJoinIterator.next()
          if context == nil then break end
          if visit(context) == false then break end
        end
      elseif directIter ~= nil then
        while true do
          local row = directIter.next()
          if row == nil then break end
          if visit(row) == false then break end
        end
      else
        for _, context in contexts :: {unknown} do
          if visit(context) == false then break end
        end
      end
    end

    local units: {Unit} = {}
    local orderAlreadySorted = false

    if aggregate then
      local nilKey = {}
      local order: {Group} = {}

      local groupCount = 0
      local function newGroup(first: unknown, groupKey: unknown?): Group
        groupCount += 1
        if groupLimit and groupCount > groupLimit then overBudget('the groups of an aggregate', groupCount, groupLimit) end

        if not compactGroupColumn and first then first = retainContext(first) end
        local group: Group = table.create(#aggregateSpecs) :: Group
        group.first = if not compactGroupColumn then first else nil
        if compactGroupColumn then group.groupKey = groupKey end
        if hasAvg then group.avgCounts = table.create(#aggregateSpecs) :: {[number]: number} end

        for index, spec in aggregateSpecs do
          if spec.name == 'COUNT' or spec.name == 'AVG' then group[index] = 0 end
          if spec.name == 'AVG' then (group.avgCounts :: {[number]:number})[index] = 0 end
        end

        return group
      end

      local function accumulate(group: Group, context: unknown)
        if not compactGroupColumn and not group.first then group.first = retainContext(context) end

        for index, spec in aggregateSpecs do
          if spec.name == 'COUNT' then
            if spec.star or (spec.argFn :: Evaluator)(context, nil, values) ~= nil then group[index] = ((group[index] or 0) :: number) + 1 end
          else
            local value = (spec.argFn :: Evaluator)(context, nil, values)

            if value ~= nil then
              if spec.name == 'SUM' then
                group[index] = ((group[index] or 0) :: number) + (value :: number)
              elseif spec.name == 'AVG' then
                group[index] = ((group[index] or 0) :: number) + (value :: number)
                local avgCounts = group.avgCounts :: {[number]: number}
                avgCounts[index] += 1
              elseif spec.name == 'MIN' then
                if group[index] == nil or (value :: number) < (group[index] :: number) then group[index] = value end
              elseif spec.name == 'MAX' then
                if group[index] == nil or (value :: number) > (group[index] :: number) then group[index] = value end
              end
            end
          end
        end
      end

      if #groupFns == 0 then
        local group = newGroup(nil)
        order[1] = group
        local columnar = columnAggregates and (directIter ~= nil
          or (type(contexts) == 'table' and rawlen(contexts) >= AggregateRows))

        if columnar then
          local feed, finish
          local awaited = AggregateDelay

          eachContext(function(context)
            if residualWhere and not sqlTruthy(residualWhere(context, nil, values)) then return nil end

            if awaited == 0 then
              feed, finish = columnAccumulator(group, aggregateSpecs, aggregateColumns, retainContext)
              awaited = math.huge
            end

            if feed and feed(context :: SourceRow) then return nil end

            if feed then
              (finish :: () -> ())()
              feed = nil
            end

            accumulate(group :: Group, context)
            awaited -= 1
            return nil
          end)

          if feed ~= nil and finish ~= nil then finish() end
        else
          eachContext(function(context)
            if not residualWhere or sqlTruthy(residualWhere(context, nil, values)) then accumulate(group :: Group, context) end
            return nil
          end)
        end
      else
        local root: {[unknown]: unknown} = {}

        eachContext(function(context)
          if not residualWhere or sqlTruthy(residualWhere(context, nil, values)) then
            local node: {[unknown]: unknown} = root
            local group: Group? = nil

            for keyIndex, evaluate in groupFns do
              local key = evaluate(context, nil, values)
              if key == nil then key = nilKey end

              if keyIndex == #groupFns then
                group = node[key] :: Group?

                if not group then
                  group = newGroup(context, if key == nilKey then nil else key)
                  node[key] = group
                  order[#order + 1] = group
                end
              else
                local nextNode = node[key] :: {[unknown]: unknown}?

                if nextNode == nil then
                  nextNode = {}
                  node[key] = nextNode
                end

                node = nextNode :: {[unknown]: unknown}
              end
            end

            accumulate(group :: Group, context)
          end
          return nil
        end)
      end

      local function groupContext(group: Group): unknown
        if not compactGroupColumn then
          return group.first or (if directSingle then {} else table.create(#sources))
        end

        local sourceIndex = compactGroupColumn.sourceIndex
        local row = { [compactGroupColumn.column] = group.groupKey }
        if directSingle then return row end
        local context = table.create(#sources)
        context[sourceIndex] = row
        return context
      end

      local keep = if #orderFns > 0 and ast.limit ~= nil then ast.offset + ast.limit else nil
      local offer: ((unknown, Group?) -> ())? = nil
      local finish: (() -> {Unit})? = nil

      if keep ~= nil and keep > 0 then offer, finish = boundedOrdering(orderFns, values, keep, sameContext) end

      for _, group in order do
        for index, spec in aggregateSpecs do
          if spec.name == 'AVG' then
            local count = (group.avgCounts :: {[number]:number})[index]
            group[index] = if count == 0 then nil else (group[index] :: number) / count
          end
        end

        local context = groupContext(group)
        if havingFn ~= nil and not sqlTruthy((havingFn :: Evaluator)(context, group, values)) then continue end

        if offer then
          (offer :: (unknown, Group?) -> ())(context, group)
        elseif keep ~= 0 then
          units[#units + 1] = { context = context, group = group }
        end
      end

      if finish then
        units = (finish :: () -> {Unit})()
        orderAlreadySorted = true
      elseif keep == 0 then
        units = {}
        orderAlreadySorted = true
      end
    else
      local stopAfter = if ast.limit ~= nil then ast.offset + ast.limit else nil

      if #orderFns == 0 or orderHandled then
        if sink then
          -- Nothing left to sort or group: each row is built and handed over as its source
          -- yields it, and the source is asked for no more once the consumer or the LIMIT stops.
          local skipped, emitted = 0, 0
          if stopAfter ~= 0 then
            eachContext(function(context)
              if residualWhere and not sqlTruthy(residualWhere(context, nil, values)) then return nil end

              if skipped < ast.offset then
                skipped += 1
                return nil
              end

              local row: Row = {}
              for index, selector in selectors do
                local value = selector(context, nil, values)
                if value ~= nil then row[resultColumns[index]] = value end
              end

              emitted += 1
              if sink(row) == false then return false end
              if ast.limit ~= nil and emitted >= ast.limit then return false end
              return nil
            end)
          end

          return { columns = resultColumns, rows = {}, streamed = true }
        end

        if stopAfter ~= 0 then
          eachContext(function(context)
            if not residualWhere or sqlTruthy(residualWhere(context, nil, values)) then
              units[#units + 1] = { context = retainContext(context), group = nil }
              if heldLimit and #units > heldLimit then overBudget('the rows a query holds to sort or return', #units, heldLimit) end
              if stopAfter ~= nil and #units >= stopAfter then return false end
            end
            return nil
          end)
        end
      elseif stopAfter ~= nil then
        if stopAfter > 0 then
          local offer, finish = boundedOrdering(orderFns, values, stopAfter, retainContext)

          -- `offer` takes a context as a visitor is handed one, and answers nothing.
          local predicate = residualWhere
          if predicate ~= nil then
            eachContext(function(context)
              if sqlTruthy((predicate :: Evaluator)(context, nil, values)) then offer(context, nil) end
              return nil
            end)
          else
            eachContext(function(context) offer(context, nil) return nil end)
          end

          units = finish()
        end

        orderAlreadySorted = true
      else
        eachContext(function(context)
          if not residualWhere or sqlTruthy(residualWhere(context, nil, values)) then
            units[#units + 1] = { context = retainContext(context), group = nil }
            if heldLimit and #units > heldLimit then overBudget('the rows a query holds to sort or return', #units, heldLimit) end
          end
          return nil
        end)
      end
    end

    if #orderFns > 0 and not orderHandled and not orderAlreadySorted then
      units = orderUnits(units, orderFns, values)
    end

    local first = ast.offset + 1
    local last = #units
    if ast.limit ~= nil then last = math.min(last, ast.offset + ast.limit) end
    local resultRows: {Row} = table.create(math.max(0, last - first + 1)) :: {Row}

    local keyed = if rowTemplate then 0 else math.huge

    for unitIndex = first, last do
      local unit = units[unitIndex]
      local row: Row

      if keyed == 0 then
        local filled = true
        row = table.clone(rowTemplate :: Row)

        for index, selector in selectors do
          local value = selector(unit.context, unit.group, values)
          if value == nil then filled = false end

          row[resultColumns[index]] = value
        end

        -- A row with a NULL cell is built key by key after all, so that a caller walking it
        -- meets its cells in the order it always has: a copy keeps the place of the missing one.
        -- So are the rows after it, for a while: where one row has a NULL cell more tend to,
        -- and a copy made only to be built again costs more than it saves.
        if not filled then
          local copied = row
          row, keyed = {}, RowRetry

          for _, name in resultColumns do
            local value = copied[name]
            if value ~= nil then row[name] = value end
          end
        end
      else
        keyed -= 1
        row = {}

        for index, selector in selectors do
          local value = selector(unit.context, unit.group, values)
          if value ~= nil then row[resultColumns[index]] = value end
        end
      end

      resultRows[#resultRows + 1] = row
    end

    return { columns = resultColumns, rows = resultRows }
  end

  function plan.run(params: {unknown}?): Result
    return execute(params, nil)
  end

  function plan.open(params: {unknown}?): Cursor
    local values: {unknown} = params or {}
    if #values < ast.params then error(string.format('jessql: query expects %d parameters, got %d', ast.params, #values), 0) end

    local finished, streaming = false, false
    local producer: thread? = nil
    -- The query runs in its own coroutine and pauses each time it has a row to hand over. It is
    -- resumed with `true` for another row and `false` to stop where it is.
    local function produce()
      local result = execute(values, function(row: Row): boolean?
        streaming = true
        return coroutine.yield(row) :: boolean
      end)

      if not result.streamed then
        for _, row in result.rows do
          if coroutine.yield(row) == false then break end
        end
      end

      return nil
    end

    local function advance(continue: boolean): Row?
      if finished then return nil end

      if not producer then producer = coroutine.create(produce) end

      local running = producer :: thread
      local ok, row = coroutine.resume(running, continue)
      if not ok then
        finished = true
        error(row, 0)
      end

      if coroutine.status(running) == 'dead' then finished = true end

      return row :: Row?
    end

    local cursor = {} :: Cursor
    cursor.columns = resultColumns

    function cursor.streaming(): boolean return streaming end

    function cursor.done(): boolean return finished end

    function cursor.next(): Row?
      return advance(true)
    end

    function cursor.page(count: number): { Row }
      if type(count) ~= 'number' or count < 1 or count % 1 ~= 0 then error('jessql: a page holds a whole number of rows, at least one', 2) end

      local rows: { Row } = {}
      while #rows < count do
        local row = advance(true)
        if not row then break end

        rows[#rows + 1] = row
      end

      return rows
    end

    function cursor.close()
      if finished then return end

      -- A query that never started has nothing to stop. One that is paused is told to stop,
      -- so its source is released by the query itself rather than abandoned.
      if producer and coroutine.status(producer) == 'suspended' then
        -- The stopped query may raise while unwinding; the cursor is closed regardless.
        pcall(advance, false)
      end

      finished = true
    end

    return cursor
  end

  plan.ast = ast
  plan.columns = resultColumns
  plan.parameterCount = ast.params

  function plan.explain()
    local joins = [
      for index, join in enumerate(ast.joins) => {
        kind = join.kind,
        table = join.source.name,
        alias = join.source.alias,
        strategy = joinPlans[index].strategy,
      }
    ]

    local scans = [for index, source in enumerate(sources) => { table = source.name, alias = source.alias, columns = neededColumns[index] }]

    return {
      scans = scans,
      joins = joins,
      grouped = aggregate,
      compactGroup = compactGroupColumn ~= nil,
      aggregateCount = #aggregateSpecs,
      providerCount = directProviderCount or directFilteredCount,
      parameterCount = ast.params,
    }
  end

  return plan
end

function engine.new(): Database
  local db = { _tables = {} :: { [string]: Provider }, _limits = nil :: Limits? }

  function db.register(self: Database, name: string, provider: Provider): Database
    if type(name) ~= 'string' or name == '' then error('jessql: table name must be a string', 2) end
    if type(provider) ~= 'table' or type(provider.scan) ~= 'function' then error('jessql: provider needs scan(request)', 2) end
    if type(provider.columns) ~= 'table' then error('jessql: provider needs columns', 2) end
    self._tables[lower(name)] = provider
    return self
  end

  function db.limits(self: Database, limits: Limits?): Database
    if limits then
      if type(limits) ~= 'table' then error('jessql: limits are a table', 2) end

      for _, name in { 'joinBuildRows', 'joinRows', 'groups', 'heldRows' } do
        local value = (limits :: { [string]: unknown })[name]
        if value ~= nil and (type(value) ~= 'number' or value ~= math.floor(value :: number) or (value :: number) < 1) then
          error(`jessql: limit {name} is a whole number of rows, at least 1`, 2)
        end
      end
    end

    self._limits = if limits then table.clone(limits) else nil
    return self
  end

  function db.table(self: Database, name: string, rows: SourceRows, columns: { string }?): Database
    columns = columns or schemaFromRows(rows)

    return self:register(name, {
      columns = columns,
      count = function() return #rows end,
      scan = function(_request) return rows end,
    })
  end

  function db.prepare(self: Database, sql: string): Plan
    return prepare(self, sql)
  end

  function db.query(self: Database, sql: string, params: { unknown }?): Result
    return prepare(self, sql).run(params)
  end

  function db.tables(self: Database): { TableInfo }
    local out: {TableInfo} = {}
    for name, provider in self._tables do out[#out + 1] = { name = name, columns = provider.columns } end
    table.sort(out, function(left: TableInfo, right: TableInfo): boolean return left.name < right.name end)
    return out
  end

  return db
end

engine.prepare = prepare
return engine
