--!strict
--!native
-- Durable multi-generation lifecycle for one hybrid table.
-- Flushes retain immutable generations; full checkpoints compact them.
-- All transitions are synchronous under the managed lock.
local fs = require('@dream/fs')
local bytes = require('@dream/bytes')
local json = require('@jess/json')
local hybrid = require('@jessql/hybrid')
local paged = require('@jessql/paged')
local segments = require('@jessql/segments')
local tiers = require('@jessql/tiers')
local engine = require('@jessql/engine')

export type Row = { [string]: unknown }
export type Options = {
  tableName: string?, columns: { string }?, primaryKey: string?,
  cachePages: number?, readMode: string?, rowLayout: string?, pageBytes: number?,
  maxHotRows: number?, maxHotBytes: number?, maxGenerations: number?, runRows: number?, mergeFanIn: number?,
  compactionFanIn: number?,
  -- Deterministic fault injection for integration tests. Throws at a named stage.
  testHook: ((string) -> ())?,
}
export type Transaction = hybrid.Transaction
export type Database = {
  get: (self: Database, key: unknown) -> Row?,
  insert: (self: Database, row: Row) -> (),
  upsert: (self: Database, row: Row) -> (),
  update: (self: Database, key: unknown, changes: Row) -> boolean,
  delete: (self: Database, key: unknown) -> boolean,
  transaction: (self: Database, callback: (Transaction) -> ()) -> (),
  query: (self: Database, sql: string, params: { unknown }?) -> engine.Result,
  prepare: (self: Database, sql: string) -> engine.Plan,
  stats: (self: Database) -> { epoch: number, generations: number, coldRows: number, hotRows: number,
    tombstones: number, hotPayloadBytes: number?, cachedPages: number },
  maintenanceStatus: (self: Database) -> { lastError: string?, poisoned: boolean },
  flush: (self: Database) -> number,
  compact: (self: Database) -> number,
  checkpoint: (self: Database) -> number,
  close: (self: Database) -> (),
}

type Generation = { epoch: number, deleted: boolean }
type Manifest = { version: number, epoch: number, tableName: string,
  columns: { string }, primaryKey: string, snapshotIdentity: string,
  generations: { Generation }? }
type Paths = { snapshot: string, deletes: string, wal: string }

local Magic = 'JQLM1\n'
local MaxManifest = 65536
local MaxEpoch = 99999999
local managed = {}

local function assertOK(ok: boolean?, message: string?, action: string)
  if not ok then error('jessql managed: ' .. action .. ': ' .. tostring(message), 3) end
end

local function directory(path: string): string
  local parent = fs.parent(path)

  if not parent then error('jessql managed: missing parent directory', 3) end
  return parent
end

local function normalize(path: string): (string, string)
  if type(path) ~= 'string' or path == '' then error('jessql managed: path required', 3) end
  local absolute, absoluteError = fs.absolute(path)

  if not absolute then error('jessql managed: ' .. tostring(absoluteError), 3) end
  local name = fs.fileName(absolute)

  if not name or not fs.isFileName(name) then error('jessql managed: invalid path', 3) end
  -- Canonical parent prevents aliases to the same managed DB from bypassing its lock.
  local parent, parentError = fs.canonicalize(directory(absolute))

  if not parent then error('jessql managed: parent: ' .. tostring(parentError), 3) end
  if not fs.isDir(parent) then error('jessql managed: parent is not a directory', 3) end
  return fs.join(parent, name), parent
end

local function paths(base: string, epoch: number): Paths
  local suffix = string.format('.g%08d', epoch)
  return { snapshot = base .. suffix .. '.rows', deletes = base .. suffix .. '.deleted',
    wal = base .. suffix .. '.wal' }
end

local function validateSchema(value: Manifest)
  if (value.version ~= 1 and value.version ~= 2) or type(value.epoch) ~= 'number' or value.epoch % 1 ~= 0
    or value.epoch < 1 or value.epoch > MaxEpoch or type(value.tableName) ~= 'string'
    or not string.match(value.tableName, '^[%a_][%w_]*$')
    or value.tableName ~= string.lower(value.tableName)
    or value.tableName == '__jessql_hybrid_deleted'
    or value.tableName == '__jessql_hybrid_identity'
    or type(value.primaryKey) ~= 'string' or type(value.snapshotIdentity) ~= 'string'
    or #value.snapshotIdentity > 8192
    or type(value.columns) ~= 'table' or #value.columns == 0 or #value.columns > 256 then
    error('jessql managed: invalid manifest schema', 3)
  end
  local unique: { [string]: boolean } = {}

  for index, name in value.columns do
    if type(index) ~= 'number' or type(name) ~= 'string'
      or not string.match(name, '^[%a_][%w_]*$') or unique[name] then
      error('jessql managed: invalid manifest columns', 3)
    end
    unique[name] = true
  end

  if not unique[value.primaryKey] then error('jessql managed: missing primary key', 3) end

  if value.version == 1 then
    if value.generations ~= nil or not string.match(value.snapshotIdentity, '^[%x]+:%d+$') then
      error('jessql managed: invalid legacy generation identity', 3)
    end
  else
    if type(value.generations) ~= 'table' or #value.generations == 0
      or #value.generations > 8 or string.sub(value.snapshotIdentity, 1, 6) ~= 'JQLM1|' then
      error('jessql managed: invalid generations', 3)
    end
    local previous = 0
    for index, generation in value.generations :: { Generation } do
      if type(index) ~= 'number' or type(generation) ~= 'table'
        or type(generation.epoch) ~= 'number' or generation.epoch % 1 ~= 0
        or generation.epoch <= previous or generation.epoch > value.epoch
        or type(generation.deleted) ~= 'boolean' then
        error('jessql managed: invalid generation entry', 3)
      end
      previous = generation.epoch
    end

    if previous ~= value.epoch then
      error('jessql managed: final generation must match publication epoch', 3)
    end
  end
end

local function manifestText(value: Manifest): string
  validateSchema(value)
  local body = json.encodeTable(value)

  if #body > MaxManifest - 64 then error('jessql managed: manifest too large', 3) end
  return Magic .. body .. '\n' .. tostring(bytes.crc32(body)) .. '\n'
end

local function readManifest(path: string): Manifest
  local raw, failure = fs.readFileString(path)

  if not raw then error('jessql managed: read manifest: ' .. tostring(failure), 3) end

  if #raw > MaxManifest or string.sub(raw, 1, #Magic) ~= Magic then
    error('jessql managed: invalid manifest header', 3)
  end
  local body, checksum = string.match(string.sub(raw, #Magic + 1), '^(.*)\n(%d+)\n$')

  if not body or not checksum or tonumber(checksum) ~= bytes.crc32(body) then
    error('jessql managed: manifest checksum mismatch', 3)
  end
  local decoded = json.decode(body) :: Manifest

  if type(decoded) ~= 'table' then error('jessql managed: invalid manifest', 3) end
  validateSchema(decoded)
  return decoded
end

local function sameSchema(left: Manifest, options: Options?)
  if not options then return end

  if options.tableName ~= nil and options.tableName ~= left.tableName then
    error('jessql managed: requested table name mismatch', 3)
  end

  if options.primaryKey ~= nil and options.primaryKey ~= left.primaryKey then
    error('jessql managed: requested primary key mismatch', 3)
  end

  if options.columns ~= nil then
    if #options.columns ~= #left.columns then error('jessql managed: column mismatch', 3) end

    for index, column in options.columns do
      if column ~= left.columns[index] then error('jessql managed: column mismatch', 3) end
    end
  end
end

local function seal(path: string, parent: string)
  local writer, openError = fs.openWrite(path, { create = false, truncate = false })

  if not writer then error('jessql managed: seal open: ' .. tostring(openError), 3) end
  local synced, syncError = writer:syncAll()
  local closed, closeError = writer:close()
  assertOK(synced, syncError, 'seal syncAll')
  assertOK(closed, closeError, 'seal close')
  local ok, err = fs.syncDirectory(parent)
  assertOK(ok, err, 'seal directory')
end

local function removeIfPresent(path: string)
  local exists, existenceError = fs.exists(path)

  if exists == nil then error('jessql managed: stat: ' .. tostring(existenceError), 3) end

  if exists then
    local removed, removeError = fs.remove(path)
    assertOK(removed, removeError, 'remove ' .. path)
  end
end

local function compactScratch(base: string, epoch: number): (string, string)
  local prefix = base .. string.format('.g%08d.hot-', epoch)
  return prefix .. 'rows', prefix .. 'deleted'
end

local function clearScratch(base: string, epoch: number)
  local rows, deletes = compactScratch(base, epoch)
  removeIfPresent(rows)
  removeIfPresent(deletes)
end

local function clearCandidate(candidatePaths: Paths)
  removeIfPresent(candidatePaths.wal)
  removeIfPresent(candidatePaths.wal .. '.lock')
  removeIfPresent(candidatePaths.snapshot)
  removeIfPresent(candidatePaths.deletes)
end

local function newManifest(active: Manifest, epoch: number, identity: string,
  generations: { Generation }?): Manifest
  return { version = if generations then 2 else 1, epoch = epoch,
    tableName = active.tableName, columns = active.columns,
    primaryKey = active.primaryKey, snapshotIdentity = identity, generations = generations }
end

local function generationList(value: Manifest): { Generation }
  if value.version == 1 then return { { epoch = value.epoch, deleted = false } } end
  return value.generations :: { Generation }
end

local function indexedPaths(base: string, value: Manifest): ({ string }, { [number]: string })
  local sources: { string } = {}
  local deleted: { [number]: string } = {}
  for index, generation in generationList(value) do
    local files = paths(base, generation.epoch)
    sources[index] = files.snapshot
    if generation.deleted then deleted[index] = files.deletes end
  end
  return sources, deleted
end

-- Open the immutable set independently before starting a WAL: a manifest is
-- authoritative only if every referenced generation and sidecar validates.
local function verifyCold(base: string, value: Manifest, options: Options?): string
  local cachePages = 1
  local readMode = if options then options.readMode else nil
  local source: paged.Snapshot
  if value.version == 1 then
    source = paged.open(paths(base, value.epoch).snapshot,
      { cachePages = cachePages, readMode = readMode })
  else
    local rows, deletes = indexedPaths(base, value)
    source = segments.open(rows, { cachePages = cachePages, readMode = readMode,
      deletePaths = deletes })
  end
  local identity = source.identity
  -- Schema validation can throw; close the candidate reader on failure.
  local ok, err = pcall(function()
    if source.primaryKey ~= value.primaryKey or #source.columns ~= #value.columns then
      error('cold generation schema mismatch')
    end

    for index, column in value.columns do
      if source.columns[index] ~= column then error('cold generation schema mismatch') end
    end

    if identity ~= value.snapshotIdentity then error('cold generation identity mismatch') end
  end)
  source:close()
  if not ok then error('jessql managed: ' .. tostring(err), 3) end
  return identity
end

local function coldIdentity(base: string, value: Manifest, options: Options?): string
  -- On creation the new candidate has no identity in the manifest yet.
  local rows, deletes = indexedPaths(base, value)
  local cold = segments.open(rows, { cachePages = 1,
    readMode = if options then options.readMode else nil, deletePaths = deletes })
  local token = cold.identity
  cold:close()
  return token
end

local function openHybrid(base: string, value: Manifest, options: Options?,
  requiredWal: boolean): hybrid.Database
  local active = paths(base, value.epoch)
  if requiredWal then
    local exists, checkError = fs.exists(active.wal)
    if not exists then error('jessql managed: active WAL missing: ' .. tostring(checkError), 3) end
  end
  verifyCold(base, value, options)
  local source: string | { string } = active.snapshot
  local deletes: { [number]: string }? = nil
  if value.version == 2 then source, deletes = indexedPaths(base, value) end

  return hybrid.open(active.wal, source, value.tableName, {
    durability = 'sync', requireIdentity = requiredWal,
    trackPayloadBytes = options ~= nil and options.maxHotBytes ~= nil,
    deletePaths = deletes,
    rowLayout = if options then options.rowLayout else 'packed',
    cachePages = if options then options.cachePages else nil,
    readMode = if options then options.readMode else nil,
  })
end

-- Only retire files that were removed from the manifest's generation list.
-- A WAL is always owned by exactly one epoch; rows can survive many epochs.
local function retire(base: string, parent: string, prior: Manifest, nextValue: Manifest)
  local retained: { [number]: boolean } = {}
  for _, generation in generationList(nextValue) do retained[generation.epoch] = true end

  for _, generation in generationList(prior) do
    if not retained[generation.epoch] then
      clearCandidate(paths(base, generation.epoch))
    end
  end
  removeIfPresent(paths(base, prior.epoch).wal)
  removeIfPresent(paths(base, prior.epoch).wal .. '.lock')
  local ok, err = fs.syncDirectory(parent)
  assertOK(ok, err, 'retirement directory')
end

-- Restart-only orphan collection. The manifest is the sole authority;
-- no valid generation may be retired merely because its epoch is old.
-- This runs under the managed lock and after the recovery directory barrier.
local function collectOrphans(base: string, parent: string, value: Manifest)
  local names, listError = fs.list(parent)
  if not names then error('jessql managed: directory list: ' .. tostring(listError), 3) end
  local referenced: { [number]: Generation } = {}
  for _, generation in generationList(value) do referenced[generation.epoch] = generation end
  local prefix = (fs.fileName(base) :: string) .. '.g'
  local removed = false

  for _, name in names do
    if string.sub(name, 1, #prefix) ~= prefix then continue end
    local number, extension = string.match(string.sub(name, #prefix + 1),
      '^(%d%d%d%d%d%d%d%d)%.([%a%.%-]+)$')
    if not number or (extension ~= 'rows' and extension ~= 'deleted'
      and extension ~= 'wal' and extension ~= 'wal.lock'
      and extension ~= 'hot-rows' and extension ~= 'hot-deleted') then continue end

    local epoch = tonumber(number) :: number
    if epoch < 1 or epoch > MaxEpoch then continue end
    local generation = referenced[epoch]
    if (extension == 'rows' and generation ~= nil)
      or (extension == 'deleted' and generation ~= nil and generation.deleted)
      or ((extension == 'wal' or extension == 'wal.lock') and epoch == value.epoch) then
      continue
    end
    -- The known managed filename was not referenced by the verified manifest.
    removeIfPresent(fs.join(parent, name))
    removed = true
  end

  if removed then
    local ok, err = fs.syncDirectory(parent)
    assertOK(ok, err, 'orphan cleanup directory')
  end
end

local function durableManifest(base: string, parent: string, value: Manifest,
  hook: ((string) -> ())?, state: { started: boolean })
  local candidate = base .. '.jql-manifest.tmp'
  removeIfPresent(candidate)
  local text = manifestText(value)
  local count, errorMessage = fs.createDurable(candidate, text)

  if count ~= #text then error('jessql managed: durable manifest: ' .. tostring(errorMessage), 3) end
  if hook then hook('before-replace') end
  -- Once replacement is attempted, failure is an uncertain publication.
  -- Never remove either candidate generation or the old WAL in this state.
  state.started = true
  local ok, failure = fs.replace(candidate, base .. '.jql-manifest')
  assertOK(ok, failure, 'replace manifest')

  if hook then hook('after-replace') end
  ok, failure = fs.syncDirectory(parent)
  assertOK(ok, failure, 'sync manifest directory')

  if hook then hook('after-directory-sync') end
end

-- Managed synchronous generation lifecycle. No background workers or group
-- commits: each cutover happens while holding this database's exclusive lock.
function managed.open(path: string, options: Options?): Database
  local base, parent = normalize(path)
  local maxHotRows = if options and options.maxHotRows ~= nil then options.maxHotRows else nil
  local maxHotBytes = if options and options.maxHotBytes ~= nil then options.maxHotBytes else nil
  local maxGenerations = if options and options.maxGenerations ~= nil
    then options.maxGenerations else 8
  if maxHotRows ~= nil and (type(maxHotRows) ~= 'number' or maxHotRows % 1 ~= 0
    or maxHotRows < 1 or maxHotRows > 1000000000) then
    error('jessql managed: invalid maxHotRows', 2)
  end

  if maxHotBytes ~= nil and (type(maxHotBytes) ~= 'number' or maxHotBytes % 1 ~= 0
    or maxHotBytes < 1 or maxHotBytes > 1000000000000) then
    error('jessql managed: invalid maxHotBytes', 2)
  end

  if type(maxGenerations) ~= 'number' or maxGenerations % 1 ~= 0
    or maxGenerations < 2 or maxGenerations > 8 then
    error('jessql managed: invalid maxGenerations', 2)
  end
  local compactionFanIn = if options and options.compactionFanIn ~= nil
    then options.compactionFanIn else 3
  if type(compactionFanIn) ~= 'number' or compactionFanIn % 1 ~= 0
    or compactionFanIn < 2 or compactionFanIn > 8 then
    error('jessql managed: invalid compactionFanIn', 2)
  end
  local lock, lockError = fs.lock(base .. '.jql-lock')

  if not lock then error('jessql managed: database locked: ' .. tostring(lockError), 2) end
  local manifestPath = base .. '.jql-manifest'
  local value: Manifest? = nil
  local current: hybrid.Database? = nil
  -- Open and initialization may fail at any I/O boundary; release the managed lock.
  local opened, failure = pcall(function()
    local exists, existsError = fs.exists(manifestPath)

    if exists == nil then error('manifest stat: ' .. tostring(existsError)) end

    if exists then
      value = readManifest(manifestPath)
      sameSchema(value :: Manifest, options)
    else
      if not options or not options.tableName or not options.columns or not options.primaryKey then
        error('first open requires tableName, columns and primaryKey')
      end
      local name = string.lower(options.tableName)
      -- Do not silently rename a user-supplied table.
      if name ~= options.tableName then error('tableName must be lowercase') end
      local initial = paths(base, 1)
      clearCandidate(initial) -- an unreferenced, uncommitted interrupted initialization
      removeIfPresent(base .. '.jql-manifest.tmp')
      paged.create(initial.snapshot, options.columns, options.primaryKey,
        function(): Row? return nil end, { pageBytes = options.pageBytes })
      seal(initial.snapshot, parent)
      local snapshot = paged.open(initial.snapshot, { cachePages = 1 })
      value = { version = 1, epoch = 1, tableName = name,
        columns = options.columns, primaryKey = options.primaryKey,
        snapshotIdentity = snapshot.identity }
      snapshot:close()
      validateSchema(value :: Manifest)
      current = openHybrid(base, value :: Manifest, options, false)
      local started = { started = false }
      durableManifest(base, parent, value :: Manifest, if options then options.testHook else nil, started)
    end

    if not current then
      current = openHybrid(base, value :: Manifest, options, true)
      -- After an interrupted publication, the new manifest may be visible
      -- before a parent-directory barrier. Re-fence it before retiring any
      -- previous generation. Failure only leaves unreachable old files.
      local synced, syncError = fs.syncDirectory(parent)
      -- Refuse writes until the observed manifest has a durable directory
      -- barrier: otherwise an earlier uncertain replacement could roll back
      -- across another power loss after newly acknowledged WAL commits.
      assertOK(synced, syncError, 'recovery manifest directory')
      -- Failed orphan removal only leaks unused files, never active data.
      pcall(function() collectOrphans(base, parent, value :: Manifest) end)
    end
  end)

  if not opened then
    -- A half-open hybrid must not leave its WAL lock held.
    if current then pcall(function() (current :: hybrid.Database):close() end) end
    lock:unlock()
    error('jessql managed: open: ' .. tostring(failure), 2)
  end

  local live = current :: hybrid.Database
  local active = value :: Manifest
  local closed, poisoned, busy = false, false, false
  local lastMaintenanceError: string? = nil
  -- Recovery cannot forget an unresolved byte watermark. A WAL may contain
  -- an acknowledged oversized transaction after failed auto-maintenance.
  -- Do not accept another write until its overlay has been retired.
  if maxHotBytes then
    local counted, result = pcall(function() return live:stats().hotPayloadBytes end)
    if not counted then
      poisoned = true
      lastMaintenanceError = 'recovered hot-byte accounting failed: ' .. tostring(result)
    elseif (result :: number) >= maxHotBytes then
      lastMaintenanceError = 'recovered hot overlay exceeds byte budget; flush or checkpoint'
    end
  end
  local db = {} :: Database

  local function ready()
    if closed then error('jessql managed: closed', 3) end
    if poisoned then error('jessql managed: uncertain publication; close and reopen', 3) end
    if busy then error('jessql managed: generation transition in progress', 3) end
  end

  function db.get(_self: Database, key: unknown): Row?
    ready()
    return live:get(key)
  end

  function db.query(_self: Database, sql: string, params: { unknown }?): engine.Result
    ready()
    return live:query(sql, params)
  end

  function db.prepare(_self: Database, sql: string): engine.Plan
    ready()
    return live:prepare(sql)
  end

  -- A successful user commit is already synchronized. Auto-maintenance is
  -- never allowed to turn that acknowledgment into an apparent failed write.
  local function autoMaintain()
    if not maxHotRows and not maxHotBytes then return end

    -- Even statistics can throw after the WAL was synchronized. Never turn
    -- an acknowledged user mutation into an apparent failed transaction.
    local ok, failure = pcall(function()
      local state = live:stats()
      local rowPressure = maxHotRows ~= nil and state.hotRows + state.tombstones >= maxHotRows
      local bytePressure = maxHotBytes ~= nil and (state.hotPayloadBytes :: number) >= maxHotBytes
      if not rowPressure and not bytePressure then return end

      if #generationList(active) >= maxGenerations then db:compact()
      else db:flush() end
    end)
    lastMaintenanceError = if ok then nil else tostring(failure)
  end

  -- An acknowledged commit must remain acknowledged if maintenance fails.
  -- With a byte watermark configured, reject subsequent writes until manual
  -- maintenance succeeds, rather than letting an error cause unbounded churn.
  local function readyToWrite()
    ready()
    if maxHotBytes and lastMaintenanceError then
      error('jessql managed: maintenance failed under hot-byte budget; flush or checkpoint', 3)
    end
  end

  function db.transaction(_self: Database, callback: (Transaction) -> ())
    readyToWrite()
    live:transaction(callback)
    autoMaintain()
  end

  function db.insert(_self: Database, row: Row)
    readyToWrite()
    live:insert(row)
    autoMaintain()
  end

  function db.upsert(_self: Database, row: Row)
    readyToWrite()
    live:upsert(row)
    autoMaintain()
  end

  function db.update(_self: Database, key: unknown, changes: Row): boolean
    readyToWrite()
    local changed = live:update(key, changes)
    if changed then autoMaintain() end
    return changed
  end

  function db.delete(_self: Database, key: unknown): boolean
    readyToWrite()
    local changed = live:delete(key)
    if changed then autoMaintain() end
    return changed
  end

  function db.stats(_self: Database)
    ready()
    local result = live:stats()
    return { epoch = active.epoch, generations = #generationList(active),
      coldRows = result.coldRows, hotRows = result.hotRows,
      tombstones = result.tombstones, hotPayloadBytes = result.hotPayloadBytes,
      cachedPages = result.cachedPages }
  end

  function db.maintenanceStatus(_self: Database): { lastError: string?, poisoned: boolean }
    if closed then error('jessql managed: closed', 2) end
    return { lastError = lastMaintenanceError, poisoned = poisoned }
  end

  -- Publish a new WAL bound to the new immutable generation set. The compact
  -- mode merges only the newest cold generations plus the hot overlay, so
  -- older generations are neither decoded nor rewritten. All write methods
  -- are fenced until the manifest and WAL identity are durably published.
  local function transition(mode: string): number
    ready()
    if active.epoch >= MaxEpoch then error('jessql managed: generation limit', 2) end

    if mode == 'delta' and #generationList(active) >= maxGenerations then
      error('jessql managed: generation budget reached; compact first', 2)
    end

    if mode == 'compact' and #generationList(active) < 2 then
      error('jessql managed: selective compaction needs two cold generations', 2)
    end
    busy = true
    local nextEpoch = active.epoch + 1
    local candidatePaths = paths(base, nextEpoch)
    local candidate: hybrid.Database? = nil
    local publication = { started = false }
    local mergedCount = 0
    -- Generation export and publication may fail; keep the old WAL authoritative.
    local completed, transitionFailure = pcall(function()
      clearCandidate(candidatePaths)
      if mode == 'compact' then clearScratch(base, nextEpoch) end

      if mode == 'delta' then
        live:exportDelta(candidatePaths.snapshot, candidatePaths.deletes, {
          pageBytes = if options then options.pageBytes else nil,
          runRows = if options then options.runRows else nil,
          mergeFanIn = if options then options.mergeFanIn else nil,
        })
        seal(candidatePaths.deletes, parent)
      elseif mode == 'compact' then
        local generations = generationList(active)
        mergedCount = math.min(#generations, compactionFanIn)
        local inputRows: { string } = {}
        local inputDeletes: { [number]: string } = {}
        local sources, deletions = indexedPaths(base, active)
        for index = #generations - mergedCount + 1, #generations do
          local slot = #inputRows + 1
          inputRows[slot] = sources[index]
          if deletions[index] then inputDeletes[slot] = deletions[index] end
        end
        local hot = live:stats()
        if hot.hotRows + hot.tombstones > 0 then
          local hotRows, hotDeletes = compactScratch(base, nextEpoch)
          live:exportDelta(hotRows, hotDeletes, {
            pageBytes = if options then options.pageBytes else nil,
            runRows = if options then options.runRows else nil,
            mergeFanIn = if options then options.mergeFanIn else nil,
          })
          inputRows[#inputRows + 1] = hotRows
          inputDeletes[#inputRows] = hotDeletes
        end

        tiers.compact(candidatePaths.snapshot, candidatePaths.deletes, inputRows, {
          fanIn = compactionFanIn,
          cachePages = if options then options.cachePages else 1,
          pageBytes = if options then options.pageBytes else nil,
          deletePaths = inputDeletes,
        })
        seal(candidatePaths.deletes, parent)
      else
        live:exportSnapshot(candidatePaths.snapshot,
          { pageBytes = if options then options.pageBytes else nil })
      end
      seal(candidatePaths.snapshot, parent)
      local nextValue: Manifest
      if mode ~= 'full' or active.version == 2 then
        local generations: { Generation } = {}
        if mode == 'delta' or mode == 'compact' then
          local all = generationList(active)
          local limit = if mode == 'compact' then #all - mergedCount else #all
          for index = 1, limit do
            local generation = all[index]
            generations[#generations + 1] = { epoch = generation.epoch, deleted = generation.deleted }
          end
        end
        generations[#generations + 1] = { epoch = nextEpoch, deleted = mode ~= 'full' }
        nextValue = newManifest(active, nextEpoch, '', generations)
        nextValue.snapshotIdentity = coldIdentity(base, nextValue, options)
      else
        local snapshot = paged.open(candidatePaths.snapshot, { cachePages = 1 })
        nextValue = newManifest(active, nextEpoch, snapshot.identity, nil)
        snapshot:close()
      end
      validateSchema(nextValue)
      if options and options.testHook then options.testHook('candidate-sealed') end
      candidate = openHybrid(base, nextValue, options, false)
      if options and options.testHook then options.testHook('wal-ready') end
      durableManifest(base, parent, nextValue,
        if options then options.testHook else nil, publication)
      local previous, prior = live, active
      live = candidate :: hybrid.Database
      candidate = nil
      active = nextValue
      previous:close()
      if options and options.testHook then options.testHook('before-retire') end
      -- Retirement can fail; old unreferenced files are safe to leave behind.
      pcall(function() retire(base, parent, prior, nextValue) end)
      if mode == 'compact' then
        -- Scratch files are unpublished and safe to leave for restart if cleanup fails.
        pcall(function() clearScratch(base, nextEpoch) end)
      end
    end)
    busy = false
    if not completed then
      -- Closing an unpublished candidate may fail; retain the first error.
      if candidate then pcall(function() (candidate :: hybrid.Database):close() end) end

      if publication.started then
        poisoned = true
      else
        -- Failed cleanup after a safe pre-publication fault must not hide that fault.
        pcall(function() clearCandidate(candidatePaths) end)
        if mode == 'compact' then
          -- Reclaim scratch after a caught pre-publication fault.
          pcall(function() clearScratch(base, nextEpoch) end)
        end
        -- Failed manifest temp cleanup must not override the publication error.
        pcall(function() removeIfPresent(base .. '.jql-manifest.tmp') end)
      end
      error('jessql managed: transition failed: ' .. tostring(transitionFailure), 2)
    end
    lastMaintenanceError = nil
    return active.epoch
  end

  function db.flush(_self: Database): number
    ready()
    local result = live:stats()
    if result.hotRows + result.tombstones == 0 then return active.epoch end
    return transition('delta')
  end

  function db.compact(_self: Database): number
    return transition('compact')
  end

  function db.checkpoint(_self: Database): number
    return transition('full')
  end

  function db.close(_self: Database)
    if closed then return end
    if busy then error('jessql managed: cannot close during publication', 2) end
    closed = true
    -- Closing a poisoned handle can fail, but the managed lock must still be released.
    local ok, err = pcall(function() live:close() end)
    lock:unlock()

    if not ok then error(err, 2) end
  end
  return db
end

return managed
