--!strict
local sql = require('@jessql')
local fs = require('@dream/fs')
local test = require('@jess/test')
local expect = test.expect
local suite = test.new()

local function fixture(name: string): (string, string)
  local root = fs.cwd() :: string
  local base = fs.join(root, '.jessql-secondary-' .. name)
  fs.remove(base .. '.cold')
  fs.remove(base .. '.index')
  return base .. '.cold', base .. '.index'
end

local function seed(path: string, count: number, changed: boolean?)
  local id = 0
  sql.paged.create(path, { 'id', 'room', 'stream', 'body' }, 'id', function()
    id += 1
    if id > count then return nil end
    local stream = id - 101
    return { id = id, room = if id % 3 == 0 then 'a' else 'b',
      stream = stream, body = if changed then 'updated' else tostring(id) }
  end, { pageBytes = 1024 })
end

suite.describe('immutable cold composite secondary index', function()
  suite.it('seeks numeric ranges in both directions without scanning other partitions', function()
    local cold, sidecar = fixture('ranges')
    seed(cold, 300)
    sql.secondary.create(sidecar, cold, 'room', 'stream', { pageBytes = 512 })
    local source = sql.paged.open(cold, { cachePages = 2 })
    local index = sql.secondary.open(sidecar, source, { cachePages = 2 })
    expect(index.complete).toBe(true)
    expect(index.count).toBe(300)
    expect(index.orderKind).toBe('number')
    local forward = index:iterate('a', false, -10, 20, true, false)
    for id = 93, 120, 3 do
      local row = forward() :: sql.Row
      expect(row.id).toBe(id)
      expect(row.room).toBe('a')
    end
    expect(forward()).toBe(nil)
    local reverse = index:iterate('a', true, -10, 20, true, true)
    for id = 120, 93, -3 do
      expect((reverse() :: sql.Row).id).toBe(id)
    end
    expect(reverse()).toBe(nil)
    expect(index:iterate('unrecognized')()).toBe(nil)
    expect(index:stats().cachedPages <= 2).toBe(true)
    index:close()
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('externally sorts multiple compaction tiers with bounded resident key counts', function()
    local cold, sidecar = fixture('external-sort')
    seed(cold, 741)
    local metrics = sql.secondary.create(sidecar, cold, 'room', 'stream',
      { pageBytes = 512, runRows = 13, mergeFanIn = 3 })
    expect(metrics.rows).toBe(741)
    expect(metrics.entries).toBe(741)
    expect(metrics.maxBufferedEntries <= 13).toBe(true)
    expect(metrics.maxOpenReaders <= 3).toBe(true)
    expect(metrics.spilledRuns > 50).toBe(true)
    expect(metrics.mergeOperations > 10).toBe(true)
    local snapshot = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, snapshot, { cachePages = 2 })
    local forward = index:iterate('a')
    for id = 3, 741, 3 do expect((forward() :: sql.Row).id).toBe(id) end
    expect(forward()).toBe(nil)
    local reverse = index:iterate('b', true)
    for id = 740, 1, -1 do
      if id % 3 ~= 0 then expect((reverse() :: sql.Row).id).toBe(id) end
    end
    expect(reverse()).toBe(nil)
    index:close()
    snapshot:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('keeps the in-memory sidecar path for small snapshots and rejects unsafe limits', function()
    local cold, sidecar = fixture('small-sort')
    seed(cold, 7)
    local metrics = sql.secondary.create(sidecar, cold, 'room', 'stream', { runRows = 16 })
    expect(metrics.spilledRuns).toBe(0)
    expect(metrics.maxOpenReaders).toBe(0)
    expect(metrics.maxBufferedEntries).toBe(7)
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source)
    expect((index:iterate('a')() :: sql.Row).id).toBe(3)
    index:close()
    source:close()
    -- The builder must reject invalid limits before creating a destination.
    local accepted = pcall(function()
      sql.secondary.create(sidecar .. '.invalid', cold, 'room', 'stream', { runRows = 0 })
    end)
    expect(accepted).toBe(false)
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('rejects an index tied to a different cold snapshot', function()
    local cold, sidecar = fixture('mismatch')
    seed(cold, 40)
    sql.secondary.create(sidecar, cold, 'room', 'stream')
    local source = sql.paged.open(cold)
    local valid = sql.secondary.open(sidecar, source)
    valid:close()
    source:close()
    fs.remove(cold)
    seed(cold, 41)
    source = sql.paged.open(cold)
    -- The source identity check must reject the replaced snapshot.
    local rejected = pcall(function() sql.secondary.open(sidecar, source) end)
    expect(rejected).toBe(false)
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('rejects corrupted sidecar pages and keeps source snapshot intact', function()
    local cold, sidecar = fixture('corruption')
    seed(cold, 60)
    sql.secondary.create(sidecar, cold, 'room', 'stream', { pageBytes = 512 })
    local source = sql.paged.open(cold)
    local raw = fs.readFileString(sidecar) :: string
    local pos = string.find(raw, 'z', 1, true) :: number
    local tampered = string.sub(raw, 1, pos - 1) .. 'x' .. string.sub(raw, pos + 1)
    local bytesWritten = fs.writeFile(sidecar, tampered, { offset = 0, create = false })
    expect(bytesWritten ~= nil).toBe(true)
    -- A damaged first page can fail metadata loading; a later page must
    -- fail before returning any affected row.
    local rejected = pcall(function()
      local index = sql.secondary.open(sidecar, source)
      local nextRow = index:iterate('a')
      nextRow()
      index:close()
    end)
    expect(rejected).toBe(false)
    expect((source:get(3) :: sql.Row).id).toBe(3)
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('sorts escaped UTF-8 strings and rejects unsafe NULL fast paths', function()
    local cold, sidecar = fixture('strings')
    local wal = cold .. '.wal'
    fs.remove(wal)
    fs.remove(wal .. '.lock')
    local values = { 'a', 'a\\b', 'quote"', 'z', 'é' }
    table.sort(values)
    local cursor = 0
    sql.paged.create(cold, { 'id', 'room', 'stream' }, 'id', function()
      cursor += 1
      if cursor > #values then return nil end
      return { id = cursor, room = '$room:example.org', stream = values[cursor] }
    end, { pageBytes = 512 })
    sql.secondary.create(sidecar, cold, 'room', 'stream', { pageBytes = 512 })
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source)
    expect(index.orderKind).toBe('string')
    local reader = index:iterate('$room:example.org')
    for _, stream in values do expect((reader() :: sql.Row).stream).toBe(stream) end
    expect(reader()).toBe(nil)
    index:close()
    source:close()
    local db = sql.hybrid.open(wal, cold, 'events', { secondaryIndexPath = sidecar })
    local rows = db:query('SELECT stream FROM events WHERE room = ? ORDER BY stream', { '$room:example.org' }).rows
    for position, stream in values do expect(rows[position].stream).toBe(stream) end
    db:close()
    fs.remove(cold)
    fs.remove(sidecar)
    fs.remove(wal)
    fs.remove(wal .. '.lock')

    cold, sidecar = fixture('nulls')
    cursor = 0
    sql.paged.create(cold, { 'id', 'room', 'stream' }, 'id', function()
      cursor += 1
      if cursor == 1 then return { id = 1, room = 'x', stream = 5 } end
      if cursor == 2 then return { id = 2, room = 'x' } end
      return nil
    end)
    sql.secondary.create(sidecar, cold, 'room', 'stream')
    source = sql.paged.open(cold)
    index = sql.secondary.open(sidecar, source)
    expect(index.complete).toBe(false)
    index:close()
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('merges indexed room streams with WAL updates, tombstones and staged changes', function()
    local cold, sidecar = fixture('hybrid')
    local wal = cold .. '.wal'
    fs.remove(wal)
    fs.remove(wal .. '.lock')
    seed(cold, 600)
    sql.secondary.create(sidecar, cold, 'room', 'stream', { pageBytes = 1024 })
    local plain = sql.hybrid.open(wal, cold, 'events', { cachePages = 2 })
    local indexed = sql.hybrid.open -- Reopen after closing the WAL lock.
    plain:close()
    local db = indexed(wal, cold, 'events', { cachePages = 2, secondaryIndexPath = sidecar })
    local function compare(sqlText: string, params: { unknown }?)
      local indexedRows = db:query(sqlText, params).rows
      db:close()
      local baseline = sql.hybrid.open(wal, cold, 'events', { cachePages = 2 })
      local plainRows = baseline:query(sqlText, params).rows
      baseline:close()
      db = indexed(wal, cold, 'events', { cachePages = 2, secondaryIndexPath = sidecar })
      expect(#indexedRows).toBe(#plainRows)
      for position, row in plainRows do
        expect(indexedRows[position].id).toBe(row.id)
        expect(indexedRows[position].stream).toBe(row.stream)
      end
    end
    local query = 'SELECT id, stream FROM events WHERE room = ? AND stream > ? ORDER BY stream LIMIT 12'
    compare(query, { 'a', 250 })
    db:transaction(function(tx)
      tx:upsert({ id = 501, room = 'a', stream = 140.5, body = 'moved-in' })
      tx:upsert({ id = 504, room = 'b', stream = 403, body = 'moved-out' })
      tx:delete(510)
      tx:insert({ id = 700, room = 'a', stream = 140.25, body = 'inserted' })
      local result = tx:query('SELECT id FROM events WHERE room = ? AND stream > ? ORDER BY stream LIMIT 4',
        { 'a', 139 })
      expect(result.rows[1].id).toBe(700)
      expect(result.rows[2].id).toBe(501)
    end)
    compare(query, { 'a', 250 })
    compare('SELECT id, stream FROM events WHERE room = ? AND stream >= ? ORDER BY stream DESC LIMIT 12',
      { 'a', 200 })
    compare('SELECT id, stream FROM events WHERE room = ? AND stream < ? ORDER BY stream LIMIT 12',
      { 'a', 140 })
    db:close()
    fs.remove(cold)
    fs.remove(sidecar)
    fs.remove(wal)
    fs.remove(wal .. '.lock')
  end)


  suite.it('round-trips compact sidecars across ordered ranges and multi-level external merging', function()
    local cold, sidecar = fixture('compact-merged')
    seed(cold, 741)
    local metrics = sql.secondary.create(sidecar, cold, 'room', 'stream',
      { format = 'compact', pageBytes = 512, runRows = 13, mergeFanIn = 3 })
    expect(metrics.spilledRuns > 50).toBe(true)
    local indexText = fs.readFileString(sidecar) :: string
    expect(string.sub(indexText, 1, 6)).toBe('JQLS1\n')
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source, { cachePages = 2 })
    expect(index.complete).toBe(true)
    expect(index.count).toBe(741)
    local forward = index:iterate('a', false, 10, 200, false, false)
    for id = 111, 300, 3 do expect((forward() :: sql.Row).id).toBe(id) end
    expect(forward()).toBe(nil)
    local reverse = index:iterate('a', true, 10, 200, false, false)
    for id = 300, 111, -3 do expect((reverse() :: sql.Row).id).toBe(id) end
    expect(reverse()).toBe(nil)
    index:close()
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('supports binary sidecars for UTF-8 string primary keys and shadowing', function()
    local cold, sidecar = fixture('compact-utf8')
    local wal = cold .. '.wal'
    fs.remove(wal)
    fs.remove(wal .. '.lock')
    local cursor = 0
    sql.paged.create(cold, { 'id', 'room', 'stream', 'body' }, 'id', function()
      cursor += 1
      if cursor > 120 then return nil end

      return { id = string.format('$event%04d:例子.org', cursor), room = '🚀room',
        stream = cursor / 2, body = 'data' }
    end, { pageBytes = 512 })
    sql.secondary.create(sidecar, cold, 'room', 'stream', { format = 'compact', pageBytes = 512 })
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source)
    local forward = index:iterate('🚀room', false, 10, 12)
    for id = 20, 24 do
      expect((forward() :: sql.Row).id).toBe(string.format('$event%04d:例子.org', id))
    end
    expect(forward()).toBe(nil)
    index:close()
    source:close()
    local db = sql.hybrid.open(wal, cold, 'events', { secondaryIndexPath = sidecar })
    db:transaction(function(tx)
      tx:delete('$event0022:例子.org')
      tx:upsert({ id = '$event0023:例子.org', room = '🚀room', stream = 1000, body = 'moved' })
    end)
    local results = db:query([[SELECT id FROM events WHERE room = ? AND stream >= ?
      ORDER BY stream LIMIT 8]], { '🚀room', 10 }).rows
    expect(results[1].id).toBe('$event0020:例子.org')
    expect(results[2].id).toBe('$event0021:例子.org')
    expect(results[3].id).toBe('$event0024:例子.org')
    db:close()
    fs.remove(cold)
    fs.remove(sidecar)
    fs.remove(wal)
    fs.remove(wal .. '.lock')
  end)

  suite.it('rejects compact corruption, mismatched snapshots, and invalid formats', function()
    local cold, sidecar = fixture('compact-integrity')
    seed(cold, 100)
    -- Expected malformed input or corruption must throw without changing usable state.
    local ok = pcall(function()
      sql.secondary.create(sidecar, cold, 'room', 'stream', { format = 'garbage' })
    end)
    expect(ok).toBe(false)
    sql.secondary.create(sidecar, cold, 'room', 'stream', { format = 'compact', pageBytes = 512 })
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source)
    expect((index:iterate('a')() :: sql.Row).id).toBe(3)
    index:close()
    source:close()
    local data = fs.readFileString(sidecar) :: string
    local tampered = string.sub(data, 1, 16) .. 'X' .. string.sub(data, 18)
    local written = fs.writeFile(sidecar, tampered, { offset = 0, create = false })
    expect(written ~= nil).toBe(true)
    source = sql.paged.open(cold)
    -- Expected malformed input or corruption must throw without changing usable state.
    local rejected = pcall(function()
      local damaged = sql.secondary.open(sidecar, source)
      damaged:iterate('a')()
      damaged:close()
    end)
    expect(rejected).toBe(false)
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
    seed(cold, 100)
    sql.secondary.create(sidecar, cold, 'room', 'stream', { format = 'compact' })
    fs.remove(cold)
    seed(cold, 101)
    source = sql.paged.open(cold)
    -- Expected malformed input or corruption must throw without changing usable state.
    rejected = pcall(function() sql.secondary.open(sidecar, source) end)
    expect(rejected).toBe(false)
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)


  suite.it('round-trips mixed primary-key scalar kinds in compact pages', function()
    local cold, sidecar = fixture('compact-mixed-pk')
    local rows: { sql.Row } = {
      { id = false, room = 'x', stream = 1 },
      { id = true, room = 'x', stream = 2 },
      { id = -2.5, room = 'x', stream = 3 },
      { id = 0, room = 'x', stream = 4 },
      { id = 1099511627777, room = 'x', stream = 5 },
      { id = '', room = 'x', stream = 6 },
      { id = 'x|\n', room = 'x', stream = 7 },
      { id = '🍀', room = 'x', stream = 8 },
    }
    local position = 0
    sql.paged.create(cold, { 'id', 'room', 'stream' }, 'id', function(): sql.Row?
      position += 1
      return rows[position]
    end, { pageBytes = 512 })
    sql.secondary.create(sidecar, cold, 'room', 'stream', { format = 'compact', pageBytes = 512 })
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source)
    local iterator = index:iterate('x')
    for _, row in rows do
      local nextRow = iterator() :: sql.Row
      expect(nextRow.id).toBe(row.id)
      expect(nextRow.stream).toBe(row.stream)
    end
    expect(iterator()).toBe(nil)
    index:close()
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

  suite.it('keeps compact and legacy index iteration exactly equivalent', function()
    local cold, compactPath = fixture('compact-parity')
    local legacyPath = compactPath .. '.legacy'
    seed(cold, 800)
    sql.secondary.create(legacyPath, cold, 'room', 'stream', { pageBytes = 512 })
    sql.secondary.create(compactPath, cold, 'room', 'stream', { pageBytes = 512, format = 'compact' })
    local source = sql.paged.open(cold)
    local compactIndex = sql.secondary.open(compactPath, source, { cachePages = 2 })
    local legacyIndex = sql.secondary.open(legacyPath, source, { cachePages = 2 })
    for testCase = 1, 40 do
      local room = if testCase % 2 == 0 then 'a' else 'b'
      local descending = testCase % 3 == 0
      local lower = testCase * 4 - 101
      local upper = lower + 75
      local first = compactIndex:iterate(room, descending, lower, upper,
        testCase % 4 == 0, testCase % 5 == 0)
      local second = legacyIndex:iterate(room, descending, lower, upper,
        testCase % 4 == 0, testCase % 5 == 0)
      while true do
        local left, right = first(), second()
        expect(left == nil).toBe(right == nil)
        if not left then break end
        expect((left :: sql.Row).id).toBe((right :: sql.Row).id)
      end
    end
    compactIndex:close()
    legacyIndex:close()
    source:close()
    fs.remove(cold)
    fs.remove(compactPath)
    fs.remove(legacyPath)
  end)

  suite.it('opens a compact sidecar over an empty cold snapshot', function()
    local cold, sidecar = fixture('compact-empty')
    sql.paged.create(cold, { 'id', 'room', 'stream' }, 'id', function(): sql.Row? return nil end)
    local metrics = sql.secondary.create(sidecar, cold, 'room', 'stream', { format = 'compact' })
    expect(metrics.entries).toBe(0)
    local source = sql.paged.open(cold)
    local index = sql.secondary.open(sidecar, source)
    expect(index.count).toBe(0)
    expect(index.complete).toBe(true)
    expect(index:iterate('missing')()).toBe(nil)
    index:close()
    source:close()
    fs.remove(cold)
    fs.remove(sidecar)
  end)

end)
return suite
